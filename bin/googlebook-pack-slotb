#!/bin/bash
# googlebook-pack-slotb
# Packs the installed Linux kernel + initramfs into the Googlebook's
# Android Slot B (boot_b / init_boot_b / vendor_boot_b) on the disk that holds "/".
# depthcharge (coreboot payload) boots Slot B directly; no GRUB/UEFI involved.
#
# Usage: googlebook-pack-slotb [kernel-version] [target-disk]
#   Called after OS install and from /etc/kernel/install.d on kernel updates.
set -euo pipefail

log() { echo "[googlebook-slotb] $*"; }

# --- ostree / bootc deployments -------------------------------------------------------
# On an ostree deployment (bootc, rpm-ostree) /usr is a composefs image mounted with
# "readonly = true" per /usr/lib/ostree/prepare-root.conf and cannot be remounted rw, so
# every artifact this script normally installs at pack time - the out-of-tree modules, the
# ISH and RT1320 firmware, the ALSA UCM override - has to be baked into the container
# image instead (see bootc/Containerfile). Probe for writability rather than assuming, so
# the same script keeps behaving exactly as before on a package-based install.
IMMUTABLE_USR=0
if ! (: >/usr/lib/.googlebook-rw-probe) 2>/dev/null; then
  IMMUTABLE_USR=1
else
  rm -f /usr/lib/.googlebook-rw-probe
fi

# The booted deployment is named to the initramfs by an "ostree=" kernel argument:
# ostree-remount.service is gated on ConditionKernelCommandLine=ostree and the ostree
# dracut module does nothing without it. Deriving root= and subvol= from findmnt the way
# the package-based path does produces neither, because / is an overlay with no UUID of
# its own. So on these systems the command line is taken from the Boot Loader
# Specification entry ostree writes, which already carries root=, ostree= and rootflags.
OSTREE_DEPLOY=0
if [[ -f /run/ostree-booted || -d /ostree/deploy || -d /sysroot/ostree/deploy ]]; then
  OSTREE_DEPLOY=1
elif grep -qs 'ostree=' /boot/loader/entries/*.conf; then
  # Packing from inside a deployment chroot, where /ostree is a symlink into /sysroot and
  # dangles unless the physical root was bind-mounted. An entry carrying ostree= is the
  # thing we actually care about, so take it as sufficient evidence on its own.
  OSTREE_DEPLOY=1
fi

# Pick the entry ostree considers the default. libostree names entries
# ostree-<n>[-<stateroot>].conf with n = n_deployments - index, writes "version" to that
# same number, and appends ":<index>" to "title" - so index 0, the deployment that boots
# next, has the highest version and a title ending in ":0)". Match that marker first and
# fall back to the highest version, which picks the same entry if the title format moves.
bls_default_entry() {
  local d e best_v=-1 best_e="" v
  for d in /boot/loader/entries /boot/loader.0/entries /boot/loader.1/entries; do
    [[ -d "$d" ]] || continue
    for e in "$d"/*.conf; do
      [[ -f "$e" ]] || continue
      grep -q '^title .*:0)[[:space:]]*$' "$e" && { printf '%s\n' "$e"; return 0; }
      v=$(sed -n 's/^version[[:space:]]\{1,\}//p' "$e" | head -1)
      [[ "$v" =~ ^[0-9]+$ ]] || v=0
      (( v > best_v )) && { best_v=$v; best_e="$e"; }
    done
    [[ -n "$best_e" ]] && { printf '%s\n' "$best_e"; return 0; }
  done
  return 1
}

BLS_ENTRY=""
if (( OSTREE_DEPLOY )); then
  BLS_ENTRY=$(bls_default_entry) || {
    log "ostree deployment detected but no Boot Loader Specification entry found."
    log "  Mount /boot (partition 11 on Moonstone) before packing."
    exit 1
  }
  log "ostree deployment; default boot entry $BLS_ENTRY"
fi

KVER="${1:-}"
VMLINUZ=""
if [[ -z "$KVER" && -n "$BLS_ENTRY" ]]; then
  # libostree always names the kernel vmlinuz-<kver>, so the version comes straight off the
  # basename. Reading it from the entry instead of from `ls /lib/modules` is what makes a
  # freshly staged deployment packable: after `bootc upgrade` the new kernel is already in
  # /boot while the running /usr still carries only the old one.
  #
  # The "linux" field is written either root-relative ("/boot/ostree/...", when ostree has
  # enable_bootprefix set) or relative to the /boot mount ("/ostree/..."), so try the
  # literal path first and the /boot-prefixed form second. Some layouts carry a
  # "/boot/boot -> ." self-symlink that makes the wrong form resolve anyway; this ordering
  # does not depend on it.
  bls_linux=$(sed -n 's/^linux[[:space:]]\{1,\}//p' "$BLS_ENTRY" | head -1)
  for cand in "$bls_linux" "/boot${bls_linux}" "/boot/${bls_linux#/}"; do
    [[ -f "$cand" ]] && { VMLINUZ="$cand"; break; }
  done
  [[ -n "$VMLINUZ" ]] || { log "kernel '$bls_linux' named by $BLS_ENTRY not found under /boot"; exit 1; }
  KVER="${VMLINUZ##*/vmlinuz-}"
fi
if [[ -z "$KVER" ]]; then
  KVER=$(ls -1 /lib/modules | sort -V | tail -1)
fi
if [[ -z "$VMLINUZ" ]]; then
  VMLINUZ="/lib/modules/$KVER/vmlinuz"
  [[ -f "$VMLINUZ" ]] || VMLINUZ="/boot/vmlinuz-$KVER"
  [[ -f "$VMLINUZ" ]] || VMLINUZ="/boot/vmlinuz-linux"
fi
[[ -f "$VMLINUZ" ]] || { log "no kernel image for $KVER"; exit 1; }

# dracut needs the module tree for $KVER, and so does the module copy into the initramfs
# further down. On a staged bootc deployment the new kernel sits in /boot while the
# running /usr still has only the old modules, so resolve the tree out of the deployment
# itself. Initramfs userspace does not have to match the kernel; its modules do.
KMOD_BASE="/lib/modules/$KVER"
KMODDIR_ARGS=()
if [[ ! -d "$KMOD_BASE" ]]; then
  for d in /ostree/deploy/*/deploy/*/usr/lib/modules/"$KVER" \
           /sysroot/ostree/deploy/*/deploy/*/usr/lib/modules/"$KVER"; do
    [[ -d "$d" ]] || continue
    KMOD_BASE="$d"
    KMODDIR_ARGS=(--kmoddir "$d")
    log "module tree for $KVER resolved to $d"
    break
  done
  [[ -d "$KMOD_BASE" ]] || { log "no module tree for $KVER"; exit 1; }
fi

DISK="${2:-}"
if [[ -z "$DISK" ]]; then
  # Locate the disk that holds /boot or / (never by global partlabel alone,
  # since during USB-C cloning the source drive may also be attached)
  BOOT_SRC=$(findmnt -no SOURCE /boot 2>/dev/null || findmnt -no SOURCE / | sed 's/\[.*\]//')
  DEV=$(readlink -f "$BOOT_SRC" 2>/dev/null || echo "$BOOT_SRC")
  while [[ "$(lsblk -ndo TYPE "$DEV" 2>/dev/null | head -1)" != "disk" ]]; do
    parent=$(lsblk -ndo PKNAME "$DEV" 2>/dev/null | head -1)
    if [[ -z "$parent" && -d "/sys/class/block/$(basename "$DEV")/slaves" ]]; then
      parent=$(ls -1 "/sys/class/block/$(basename "$DEV")/slaves" 2>/dev/null | head -1)
    fi
    [[ -n "$parent" ]] || break
    DEV="/dev/$parent"
  done
  DISK="$DEV"
fi

partdev() { lsblk -lnpo NAME,PARTLABEL "$DISK" | awk -v l="$1" '$2==l{print $1}' | head -1; }
BOOT_B=$(partdev boot_b); INIT_B=$(partdev init_boot_b); VEND_B=$(partdev vendor_boot_b)
if [[ -z "$BOOT_B" || -z "$INIT_B" || -z "$VEND_B" ]]; then
  log "no Android Slot B partitions on $DISK; not a Googlebook disk layout, skipping"
  exit 0
fi
log "kernel $KVER  disk $DISK"
log "targets: $BOOT_B $INIT_B $VEND_B"

SELF_DIR="$(dirname "$(dirname "$(readlink -f "$0")")")"
[[ -d "$SELF_DIR/coreboot-mods" ]] || [[ ! -d /usr/local/share/googlebook-dualboot/coreboot-mods ]] || SELF_DIR=/usr/local/share/googlebook-dualboot
if [[ -d "$SELF_DIR/coreboot-mods" && "$SELF_DIR" != "/usr/local/share/googlebook-dualboot" && $EUID -eq 0 ]]; then
  mkdir -p /usr/local/share/googlebook-dualboot /usr/local/bin 2>/dev/null || true
  cp -rf "$SELF_DIR"/{bin,coreboot-mods,audio-mods,sensor-mods,googleboot-menu} /usr/local/share/googlebook-dualboot/ 2>/dev/null || true
  for tool in googlebook-pack-slotb googlebook-restore-slotb googlebook-switch-slot mkbootimg; do
    [[ -f "/usr/local/share/googlebook-dualboot/bin/$tool" ]] && ln -sf "/usr/local/share/googlebook-dualboot/bin/$tool" "/usr/local/bin/$tool" 2>/dev/null || true
  done
fi
export PATH="$SELF_DIR/bin:/usr/local/bin:$PATH"
command -v mkbootimg >/dev/null || dnf install -y android-tools >/dev/null 2>&1 || apt-get install -y mkbootimg >/dev/null 2>&1 || pacman -S --noconfirm --needed android-tools >/dev/null 2>&1 || true
# Slot B needs a systemd-based dracut initramfs; dracut-core coexists with Ubuntu's initramfs-tools.
command -v dracut >/dev/null || apt-get install -y dracut-core zstd kexec-tools >/dev/null 2>&1 || pacman -S --noconfirm --needed dracut zstd kexec-tools >/dev/null 2>&1 || true
command -v dracut >/dev/null || { log "dracut not found. Install dracut-core/dracut, zstd, and kexec-tools first."; exit 1; }
command -v mkbootimg >/dev/null || { log "mkbootimg unavailable"; exit 1; }
mkbootimg --help >/dev/null || { log "mkbootimg cannot run"; exit 1; }

# --- ensure coreboot_table.ko & framebuffer-coreboot.ko are installed for $KVER ---
# Where /usr is immutable, the modules, the firmware and the UCM override below are all
# already in the container image and every step here is a deliberate no-op rather than a
# failure. `mkdir -p` on an existing directory succeeds even on a read-only filesystem, so
# only the paths that would genuinely be created need guarding.
if (( IMMUTABLE_USR )); then
  log "immutable /usr: using the modules, firmware and UCM already in the image"
fi
mkdir -p "/lib/modules/$KVER/extra" 2>/dev/null || true
if (( ! IMMUTABLE_USR )) && [[ -d "$SELF_DIR/coreboot-mods/prebuilt/$KVER" ]]; then
  cp -f "$SELF_DIR/coreboot-mods/prebuilt/$KVER"/*.ko "/lib/modules/$KVER/extra/" 2>/dev/null || true
elif [[ -d "$SELF_DIR/coreboot-mods" && -d "/lib/modules/$KVER/build" ]]; then
  CB_BUILD=$(mktemp -d)
  cp -rf "$SELF_DIR/coreboot-mods"/* "$CB_BUILD/"
  make -C "/lib/modules/$KVER/build" M="$CB_BUILD" modules >/dev/null 2>&1 || true
  strip --strip-debug "$CB_BUILD"/*.ko 2>/dev/null || true
  cp -f "$CB_BUILD"/*.ko "/lib/modules/$KVER/extra/" 2>/dev/null || true
  rm -rf "$CB_BUILD"
fi

# --- ensure Moonstone SoundWire audio modules (snd-soc-sdw-utils.ko & snd-soc-sof-sdw.ko), RT1320 firmware & UCM are installed ---
AUDIO_MODS_DIR="$SELF_DIR/audio-mods"
[[ -d "$AUDIO_MODS_DIR/sdw_utils" ]] || AUDIO_MODS_DIR="/usr/local/src/moonstone-audio-fix"
[[ -d "$AUDIO_MODS_DIR/sdw_utils" ]] || AUDIO_MODS_DIR="/usr/share/omarchy/install/hardware/audio-mods"
mkdir -p "/lib/modules/$KVER/updates" 2>/dev/null || true
if (( ! IMMUTABLE_USR )) && [[ -d "$AUDIO_MODS_DIR/prebuilt/$KVER" ]]; then
  cp -f "$AUDIO_MODS_DIR/prebuilt/$KVER"/*.ko "/lib/modules/$KVER/updates/" 2>/dev/null || true
elif [[ -d "$AUDIO_MODS_DIR/sdw_utils" && -d "/lib/modules/$KVER/build" ]]; then
  AUD_BUILD=$(mktemp -d)
  cp -rf "$AUDIO_MODS_DIR"/{Makefile,sdw_utils,intel,codecs} "$AUD_BUILD/"
  make -C "/lib/modules/$KVER/build" M="$AUD_BUILD" modules >/dev/null 2>&1 || true
  strip --strip-debug "$AUD_BUILD/sdw_utils/snd-soc-sdw-utils.ko" "$AUD_BUILD/intel/boards/snd-soc-sof-sdw.ko" 2>/dev/null || true
  cp -f "$AUD_BUILD/sdw_utils/snd-soc-sdw-utils.ko" "$AUD_BUILD/intel/boards/snd-soc-sof-sdw.ko" "/lib/modules/$KVER/updates/" 2>/dev/null || true
  rm -rf "$AUD_BUILD"
fi
if (( ! IMMUTABLE_USR )) && [[ -d "$AUDIO_MODS_DIR/firmware/realtek/rt1320" ]]; then
  mkdir -p /lib/firmware/realtek/rt1320
  cp -f "$AUDIO_MODS_DIR/firmware/realtek/rt1320"/*.dat /lib/firmware/realtek/rt1320/ 2>/dev/null || true
fi
if (( ! IMMUTABLE_USR )) && [[ -d /usr/share/alsa/ucm2 ]]; then
  mkdir -p /usr/share/alsa/ucm2/codecs/rt721+rt1320
  cat > /usr/share/alsa/ucm2/codecs/rt721+rt1320/init.conf <<'UCMEOF'
# RT721 + RT1320 combo speaker specific volume control settings

FixedBootSequence [
	msleep 200
	cset "name='rt1320-1 Brown Out Switch' 0"
	cset "name='rt1320-1 RAE Update' 1"
	cset "name='rt1320-1 FU21 Playback Volume' 87"
]

BootSequence [
	cset "name='rt1320-1 Brown Out Switch' 0"
	cset "name='rt1320-1 RAE Update' 1"
	cset "name='rt1320-1 FU21 Playback Volume' 87"
	cset "name='rt1320-1 OT23 L Switch' 0"
	cset "name='rt1320-1 OT23 R Switch' 0"
	cset "name='Speaker Switch' 0,0"
]
UCMEOF
  if [[ -f /usr/share/alsa/ucm2/sof-soundwire/rt721.conf ]]; then
    sed -i 's/Regex "(rt721(-sdca)?)"/Regex "^(rt721(-sdca)?)$"/' /usr/share/alsa/ucm2/sof-soundwire/rt721.conf 2>/dev/null || true
  fi
fi
# Fedora omits the Chrome EC ISHTP bridge; keep the upstream driver buildable.
SENSOR_MODS_DIR="$SELF_DIR/sensor-mods"
[[ -d "$SENSOR_MODS_DIR" ]] || SENSOR_MODS_DIR="/usr/local/share/googlebook-sensors"
[[ -d "$SENSOR_MODS_DIR" ]] || SENSOR_MODS_DIR="/usr/share/omarchy/install/hardware/sensor-mods"
if (( IMMUTABLE_USR )) && [[ -d "$SENSOR_MODS_DIR" ]]; then
  # The bridge module and the ISH firmware are in the image; 91-googlebook-sensors.conf
  # ships there too, so there is nothing left to install - but SENSOR_MODS_DIR still has
  # to stay set, because the initramfs copy further down reads from it.
  :
elif [[ -d "$SENSOR_MODS_DIR" ]]; then
  if [[ -f "$SENSOR_MODS_DIR/prebuilt/$KVER/cros_ec_ishtp.ko" ]]; then
    install -D -m644 "$SENSOR_MODS_DIR/prebuilt/$KVER/cros_ec_ishtp.ko" "/lib/modules/$KVER/extra/cros_ec_ishtp.ko"
  elif ! modinfo -k "$KVER" cros_ec_ishtp >/dev/null 2>&1 && [[ -d "/lib/modules/$KVER/build" ]]; then
    SENSOR_BUILD=$(mktemp -d)
    cp "$SENSOR_MODS_DIR"/{Makefile,cros_ec.h,cros_ec_ishtp.c} "$SENSOR_BUILD/"
    if make -C "/lib/modules/$KVER/build" M="$SENSOR_BUILD" modules >/dev/null 2>&1; then
      strip --strip-debug "$SENSOR_BUILD/cros_ec_ishtp.ko" 2>/dev/null || true
      install -D -m644 "$SENSOR_BUILD/cros_ec_ishtp.ko" "/lib/modules/$KVER/extra/cros_ec_ishtp.ko"
    else
      log "warning: could not build cros_ec_ishtp for $KVER; continuing without tablet sensor bridge"
    fi
    rm -rf "$SENSOR_BUILD"
  fi
  install -D -m644 "$SENSOR_MODS_DIR/firmware/intel/ish/ish_ptl_62b0f067_501de2f8.bin" \
    /lib/firmware/intel/ish/ish_ptl_62b0f067_501de2f8.bin
  mkdir -p /etc/dracut.conf.d
  cat > /etc/dracut.conf.d/91-googlebook-sensors.conf <<'SENSOREOF'
add_drivers+=" intel_ish_ipc cros_ec_ishtp cros_ec_sensors cros_ec_lid_angle cros_ec_keyb "
install_items+=" /lib/firmware/intel/ish/ish_ptl_62b0f067_501de2f8.bin "
SENSOREOF
fi
depmod -a "$KVER" 2>/dev/null || true

mkdir -p /etc/modules-load.d /etc/modprobe.d /etc/dracut.conf.d
printf "coreboot_table\nframebuffer-coreboot\n" > /etc/modules-load.d/coreboot-fb.conf
rm -f /etc/modprobe.d/googlebook-no-xe.conf
cat > /etc/modprobe.d/googlebook-xe-staged.conf <<'EOF'
blacklist i915
blacklist xe
options xe gsc_firmware_path="" huc_firmware_path="" wedged_mode=0 enable_psr=0
options spi_intel_pci writeable=1
EOF
cat > /etc/dracut.conf.d/90-googlebook-slotb.conf <<'EOF'
omit_drivers+=" i915 xe amdgpu radeon nouveau cxgb4 iwlwifi iwlmld btintel btintel_pcie bluetooth cfg80211 mac80211 snd snd_sof snd_sof_pci_intel_ptl soundwire_bus intel_vpu "
add_drivers+=" nvme nvme_core btrfs uas usb_storage coreboot_table framebuffer-coreboot cros_ec cros_ec_lpcs cros_ec_keyb erofs overlay loop "
filesystems+=" erofs overlay "
compress="zstd -19 -T0"
EOF

# Refuse to pack an image that cannot drive the panel. Depthcharge hands Linux a coreboot
# framebuffer and nothing else binds to it, so without these two modules Slot B comes up
# with no display, no console and no log - the hardest failure to diagnose on this machine,
# and the one this toolkit has hit most often. Verified here rather than assumed, because
# every install path above is best-effort (`|| true`) and an immutable /usr skips them
# entirely, which means a successful-looking pack is not evidence that the modules exist.
fb_missing=""
for m in coreboot_table framebuffer-coreboot; do
  find "$KMOD_BASE" -name "$m.ko" -o -name "$m.ko.*" 2>/dev/null | grep -q . \
    || fb_missing="$fb_missing $m"
done
if [[ -n "$fb_missing" ]]; then
  log "ERROR: missing coreboot framebuffer module(s):$fb_missing"
  log "  searched $KMOD_BASE for kernel $KVER"
  log "  Packing now would leave Slot B with a black screen."
  if (( IMMUTABLE_USR )); then
    log "  This is an image-based system, so they must be built into the image itself."
    log "  Build from bootc/Containerfile, which compiles them against the image's kernel,"
    log "  and check that the image you deployed is the Googlebook one and not its base."
  else
    log "  Install kernel-devel-$KVER plus gcc and make, then run this again."
  fi
  log "  Set GOOGLEBOOK_ALLOW_NO_FB=1 to pack anyway (expect no display)."
  [[ "${GOOGLEBOOK_ALLOW_NO_FB:-0}" == "1" ]] || exit 1
  log "  GOOGLEBOOK_ALLOW_NO_FB=1 set; continuing without a usable framebuffer."
fi

W=$(mktemp -d)
trap 'rm -rf "$W"' EXIT

# An ostree deployment needs the dracut "ostree" module, and --hostonly is what takes it
# away. That module's check() probes the running system, so packing from an installer or
# live chroot - the one case where the machine cannot pack itself - shows it the installer's
# /run and /proc rather than an ostree-booted system, and dracut drops it silently. The
# archive check below catches the result, but only after a five-minute build; --force-add is
# dracut's override for modules that -H probing would discard. Passed only when the module
# is really present, because dracut fails the whole run on a force-add it cannot resolve,
# and a module that is simply absent is a broken image - worth saying so in those words.
FORCE_ADD=()
if (( OSTREE_DEPLOY )); then
  OSTREE_DMOD=$(ls -d /usr/lib/dracut/modules.d/*ostree 2>/dev/null | head -1)
  if [[ -n "$OSTREE_DMOD" ]]; then
    FORCE_ADD=(--force-add ostree)
    log "forcing dracut module $(basename "$OSTREE_DMOD") past hostonly probing"
  else
    log "ERROR: no ostree dracut module under /usr/lib/dracut/modules.d"
    log "  This deployment mounts /usr as a composefs and only that module puts"
    log "  ostree-prepare-root in the initramfs. Packing now would write a Slot B that"
    log "  boots whatever userspace is in the bare subvolume, with nothing logged."
    log "  Rebuild the image from bootc/Containerfile, which ships the module. Do not copy"
    log "  one into this deployment: its /usr is hardlinked into /ostree/repo, so editing a"
    log "  file in place corrupts that object for every deployment sharing it."
    exit 1
  fi
fi

# --- build hostonly initramfs omitting blacklisted GPU/Wi-Fi/BT/Audio firmware so it fits in Slot B ---
# --tmpdir: dracut defaults to /var/tmp, which does not exist on an image-based system
# until systemd-tmpfiles has run - so not inside a deployment chroot, and not in a
# container. $W is already a private mktemp -d and is cleaned up by the EXIT trap.
dracut -f --hostonly --no-early-microcode --kver "$KVER" --tmpdir "$W" ${KMODDIR_ARGS[@]+"${KMODDIR_ARGS[@]}"} \
  ${FORCE_ADD[@]+"${FORCE_ADD[@]}"} \
  --omit-drivers "i915 xe amdgpu radeon nouveau cxgb4 iwlwifi iwlmld btintel btintel_pcie bluetooth cfg80211 mac80211 snd snd_sof snd_sof_pci_intel_ptl soundwire_bus intel_vpu" \
  --add-drivers "nvme nvme_core btrfs uas usb_storage coreboot_table framebuffer-coreboot cros_ec cros_ec_lpcs cros_ec_keyb erofs overlay loop" \
  --filesystems "erofs overlay" \
  --compress "zstd -19 -T0" "$W/initramfs.img" >"$W/dracut.log" 2>&1 \
  || { log "dracut failed:"; sed -n '1,60p' "$W/dracut.log" | sed 's/^/    /'; exit 1; }

# --- precondition: composefs needs erofs and overlay INSIDE the initramfs -----------------
# On an ostree/bootc deployment ostree-prepare-root mounts /usr as a composefs, which is an
# EROFS image composed through overlayfs. It does that with fsopen("erofs"), and fsopen
# returns ENODEV when the filesystem type is not registered - so a Slot B image without
# erofs.ko dies in the initramfs with
#   ostree-prepare-root: Failed to mount composefs: composefs: failed to mount: No such device
# and drops to an emergency shell that a bootc image's locked root account cannot open.
# add_drivers above pins them, but assert it rather than trust it: this is the same class of
# silent failure as the missing framebuffer modules, and just as unrecoverable in the field.
if (( OSTREE_DEPLOY )); then
  # List the archive with the same zstd|cpio pipeline the split below uses, not lsinitrd:
  # lsinitrd needs its own temporary directory and a decompressor it picks by sniffing, and
  # a deployment chroot is exactly the environment where that quietly produces nothing - at
  # which point every module looks absent and the diagnosis points at the wrong thing.
  CFS_LIST="$W/initramfs.list"
  if ! ( /usr/lib/dracut/skipcpio "$W/initramfs.img" 2>/dev/null || cat "$W/initramfs.img" ) \
       | zstd -d 2>/dev/null | cpio -t --quiet > "$CFS_LIST" 2>/dev/null; then
    : > "$CFS_LIST"
  fi
  if [[ ! -s "$CFS_LIST" ]]; then
    log "ERROR: cannot list the generated initramfs - refusing to pack blind."
    log "  Tried: skipcpio | zstd -d | cpio -t on $W/initramfs.img"
    log "  Check that zstd and cpio work in this chroot."
    exit 1
  fi
  cfs_missing=""
  for m in erofs overlay; do
    grep -q "/$m\.ko" "$CFS_LIST" || cfs_missing="$cfs_missing $m"
  done
  # The modules are useless if nothing runs ostree-prepare-root. It is pulled in only by the
  # symlink the ostree dracut module drops into initrd-root-fs.target.wants (.requires on
  # some ostree versions, so either is accepted). Its absence is silent in a way the
  # composefs failure is not: with no unit there is no
  # OnFailure=emergency.target, systemd mounts root=/rootflags= from the command line, and
  # switch-root lands in the bare subvolume. Since "bootc install to-existing-root" leaves
  # the previous OS's files in that subvolume, the machine boots happily into the OLD
  # userspace with nothing logged anywhere. Assert the symlink, not just the binary.
  if ! grep -qE 'initrd-root-fs\.target\.(wants|requires)/ostree-prepare-root\.service' "$CFS_LIST"; then
    cfs_missing="$cfs_missing ostree-prepare-root.service(initrd-root-fs.target.wants|.requires)"
  fi
  if [[ -n "$cfs_missing" ]]; then
    log "ERROR: initramfs is missing composefs module(s):$cfs_missing"
    log "  An ostree deployment mounts /usr as a composefs - an EROFS image composed through"
    log "  overlayfs - so without these Slot B dies in the initramfs with"
    log "    ostree-prepare-root: Failed to mount composefs: ... No such device"
    log "  Diagnosis:"
    for m in erofs overlay; do
      src=$(find "$KMOD_BASE" -name "$m.ko" -o -name "$m.ko.*" 2>/dev/null | head -1)
      if [[ -n "$src" ]]; then
        log "    $m: present in the module tree at $src"
      else
        log "    $m: NOT in the module tree under $KMOD_BASE - the deployment is incomplete"
      fi
    done
    log "    initramfs lists $(wc -l < "$CFS_LIST") entries, $(grep -c '\.ko' "$CFS_LIST") of them modules"
    log "    add_drivers in effect: $(sed -n 's/^add_drivers+=//p' /etc/dracut.conf.d/90-googlebook-slotb.conf 2>/dev/null)"
    # Which of the two shapes this is: no module to install, or a module dracut refused.
    log "    ostree dracut module: ${OSTREE_DMOD:-NOT PRESENT under /usr/lib/dracut/modules.d}"
    if [[ -s "$W/dracut.log" ]] && grep -qi ostree "$W/dracut.log"; then
      log "    what dracut said about it:"
      grep -i ostree "$W/dracut.log" | head -10 | sed 's/^/      /' || true
    else
      log "    dracut never mentioned ostree - the module was not even considered"
    fi
    # Ask dracut-install directly, in this same environment, with the same omit regex
    # dracut would have used. This separates "dracut never tried" from "dracut tried and
    # the module was rejected", which is the whole question and cannot be guessed from here.
    if [[ -x /usr/lib/dracut/dracut-install ]]; then
      log "    direct dracut-install probe:"
      mkdir -p "$W/probe"
      /usr/lib/dracut/dracut-install -D "$W/probe" --kerneldir "$KMOD_BASE" \
        -N "i915|xe|amdgpu|radeon|nouveau|cxgb4|iwlwifi|iwlmld|btintel|btintel_pcie|bluetooth|cfg80211|mac80211|snd|snd_sof|snd_sof_pci_intel_ptl|soundwire_bus|intel_vpu" \
        -m erofs overlay >"$W/probe.log" 2>&1
      probe_rc=$?
      sed 's/^/      /' "$W/probe.log"
      log "      exit=$probe_rc installed=$(find "$W/probe" -name '*.ko*' 2>/dev/null | wc -l)"
      find "$W/probe" -name '*.ko*' 2>/dev/null | sed 's/^/      /'
    fi
    if [[ -s "$W/dracut.log" ]]; then
      log "    last 40 lines of the dracut log:"
      tail -40 "$W/dracut.log" | sed 's/^/      /'
    fi
    exit 1
  fi
fi

# --- kernel command line ---
# Arguments this toolkit is responsible for, regardless of where the rest comes from.
GB_ARGS="rw console=tty0 rd.driver.pre=coreboot_table,framebuffer-coreboot clk_ignore_unused bootconfig"
# GOOGLEBOOK_VERBOSE=1 trades the quiet splash for a readable boot. Worth knowing why this
# needs a repack at all: the command line lives in vendor_boot_b's vendor_cmdline field, not
# in a bootloader config, so there is nothing to edit at boot time - Depthcharge offers no
# prompt and there is no GRUB. If Slot B lands somewhere unexpected and the journal did not
# survive, this is the only way to watch it happen.
if [[ "${GOOGLEBOOK_VERBOSE:-0}" == "1" ]]; then
  GB_ARGS="$GB_ARGS rd.info systemd.show_status=1 systemd.log_level=info"
  log "GOOGLEBOOK_VERBOSE=1: packing a verbose command line (no quiet/rhgb)"
else
  GB_ARGS="$GB_ARGS quiet rhgb"
fi
if [[ -n "$BLS_ENTRY" ]]; then
  # ostree owns root=, ostree= and rootflags= for its deployments, and rewrites them on
  # every upgrade and rollback, so take them from the entry verbatim and only add our own
  # on top. Strip anything we are about to set ourselves so it is not specified twice.
  BLS_OPTS=$(sed -n 's/^options[[:space:]]\{1,\}//p' "$BLS_ENTRY" | head -1)
  CMDLINE=""
  for arg in $BLS_OPTS; do
    case "$arg" in
      rw|ro|console=tty0|quiet|rhgb|bootconfig|clk_ignore_unused|rd.driver.pre=*) continue ;;
      rd.info|systemd.show_status=*|systemd.log_level=*) continue ;;
    esac
    CMDLINE="${CMDLINE:+$CMDLINE }$arg"
  done
  CMDLINE="$CMDLINE $GB_ARGS"
  case " $CMDLINE " in
    *" ostree="*) ;;
    *) log "warning: $BLS_ENTRY has no ostree= argument; the deployment will not be found" ;;
  esac
else
  ROOT_UUID=$(findmnt -no UUID /)
  SUBVOL=$(findmnt -no OPTIONS / | tr ',' '\n' | sed -n 's/^subvol=\/\{0,1\}//p' | head -1)
  CMDLINE="root=UUID=$ROOT_UUID $GB_ARGS"
  [[ -n "$SUBVOL" ]] && CMDLINE="$CMDLINE rootflags=subvol=$SUBVOL"
fi
if [[ -s /etc/crypttab ]]; then
  while read -r _name dev _rest; do
    [[ -z "$_name" || "$_name" == \#* ]] && continue
    case " $CMDLINE " in *" rd.luks.uuid=${dev#UUID=} "*) continue ;; esac
    CMDLINE="$CMDLINE rd.luks.uuid=${dev#UUID=}"
  done < /etc/crypttab
fi
log "cmdline: $CMDLINE"

# --- pack vendor_boot (32 MiB) + init_boot (8 MiB) as independent cpio.zst archives ---
VEND_MAX=$((33554432 - 65536))
INIT_MAX=$((8388608 - 8192))
SZ=$(stat -c %s "$W/initramfs.img")
log "initramfs size: $SZ bytes"

# --- unpack and split into two independent compressed cpio archives (rd_vendor + rd_init) ---
# Also inject googleboot-menu so Slot B always boots into the graphical OS selector!
mkdir -p "$W/unpacked" "$W/split_init/usr/lib"
(cd "$W/unpacked" && ( /usr/lib/dracut/skipcpio "$W/initramfs.img" 2>/dev/null || cat "$W/initramfs.img" ) | zstd -d | cpio -idm --quiet)
rm -rf "$W/unpacked/usr/lib/firmware"/{xe,i915,amdgpu,radeon,nvidia,cxgb4,LENOVO,dell,HP,iwlwifi*,intel/ibt*,intel/vpu*,intel/sof*,intel/qat*,qat*,cavium,qcom,mediatek,ath*,brcm} 2>/dev/null || true
if [[ -d "$SENSOR_MODS_DIR" ]]; then
  mkdir -p "$W/unpacked/usr/local/share/googlebook-sensors"
  cp "$SENSOR_MODS_DIR"/{Makefile,cros_ec.h,cros_ec_ishtp.c} "$W/unpacked/usr/local/share/googlebook-sensors/"
  cp -a "$SENSOR_MODS_DIR/firmware" "$W/unpacked/usr/local/share/googlebook-sensors/"
fi
mv "$W/unpacked/usr/lib/modules" "$W/split_init/usr/lib/modules"

for menu_installer in \
  "$SELF_DIR/googleboot-menu/scripts/install-into-initramfs.sh" \
  "/usr/local/share/googleboot-menu/scripts/install-into-initramfs.sh"; do
  if [[ -x "$menu_installer" ]]; then
    "$menu_installer" "$W/unpacked"
    break
  fi
done

for sync_script in \
  "$SELF_DIR/bin/googlebook-sysroot-sync" \
  "/usr/local/bin/googlebook-sysroot-sync" \
  "/usr/bin/googlebook-sysroot-sync"; do
  if [[ -f "$sync_script" ]]; then
    mkdir -p "$W/unpacked/usr/bin" "$W/unpacked/usr/local/bin" \
             "$W/unpacked/usr/local/lib/googlebook-mods" \
             "$W/unpacked/usr/local/lib/googlebook-audio-mods" \
             "$W/unpacked/usr/local/share/googlebook-audio/firmware" \
             "$W/unpacked/etc/systemd/system/initrd.target.wants" \
             "$W/unpacked/etc/systemd/system/initrd-switch-root.target.wants"
    cp -f "$KMOD_BASE/extra"/*.ko "$W/unpacked/usr/local/lib/googlebook-mods/" 2>/dev/null || true
    cp -f "$KMOD_BASE/updates"/snd-soc-*.ko "$W/unpacked/usr/local/lib/googlebook-audio-mods/" 2>/dev/null || true
    cp -f /lib/firmware/realtek/rt1320/rt1320_*Google_Moonstone*.dat "$W/unpacked/usr/local/share/googlebook-audio/firmware/" 2>/dev/null || true
    cp -f "$sync_script" "$W/unpacked/usr/bin/googlebook-sysroot-sync"
    cp -f "$sync_script" "$W/unpacked/usr/local/bin/googlebook-sysroot-sync"
    chmod 755 "$W/unpacked/usr/bin/googlebook-sysroot-sync" "$W/unpacked/usr/local/bin/googlebook-sysroot-sync"
    if [[ -f "$SELF_DIR/bin/googlebook-restore-slotb" ]]; then
      cp -f "$SELF_DIR/bin/googlebook-restore-slotb" "$W/unpacked/usr/local/bin/googlebook-restore-slotb"
      chmod 755 "$W/unpacked/usr/local/bin/googlebook-restore-slotb"
    fi
    # Distro add-ons (e.g. the Fedomakase branch) put extra sync steps here. /usr is read
    # first so an image-based system can ship them where image content belongs: on a bootc
    # deployment /usr is carried by the image itself, while /etc goes through ostree's
    # 3-way merge on every upgrade. Both land at the same path in the initramfs, /etc last
    # so a local step still overrides one of the same name from the image.
    mkdir -p "$W/unpacked/etc/googlebook/sysroot-sync.d"
    for sync_d in /usr/lib/googlebook/sysroot-sync.d /etc/googlebook/sysroot-sync.d; do
      [[ -d "$sync_d" ]] || continue
      cp -a "$sync_d/." "$W/unpacked/etc/googlebook/sysroot-sync.d/"
    done
    # Ship nothing rather than an empty directory when neither source exists.
    rmdir "$W/unpacked/etc/googlebook/sysroot-sync.d" "$W/unpacked/etc/googlebook" 2>/dev/null || true
    cat > "$W/unpacked/etc/systemd/system/googlebook-sysroot-sync.service" << 'SYNCSVCEOF'
[Unit]
Description=GoogleBook Moonstone Sysroot Hardware & Module Sync
DefaultDependencies=no
After=initrd-root-fs.target sysroot.mount
Before=initrd-switch-root.target

[Service]
Type=oneshot
ExecStart=/usr/bin/googlebook-sysroot-sync
RemainAfterExit=yes

[Install]
WantedBy=initrd.target initrd-switch-root.target
SYNCSVCEOF
    ln -sf ../googlebook-sysroot-sync.service "$W/unpacked/etc/systemd/system/initrd.target.wants/googlebook-sysroot-sync.service"
    ln -sf ../googlebook-sysroot-sync.service "$W/unpacked/etc/systemd/system/initrd-switch-root.target.wants/googlebook-sysroot-sync.service"
    break
  fi
done

(cd "$W/unpacked" && find . -print0 | cpio --null -o -H newc --quiet | zstd --ultra -22 -T0 > "$W/rd_vendor")
(cd "$W/split_init" && find . -print0 | cpio --null -o -H newc --quiet | zstd --ultra -22 -T0 > "$W/rd_init")

VSZ=$(stat -c %s "$W/rd_vendor")
ISZ=$(stat -c %s "$W/rd_init")
log "rd_vendor: $VSZ bytes (limit $VEND_MAX), rd_init: $ISZ bytes (limit $INIT_MAX)"
(( VSZ <= VEND_MAX )) || { log "rd_vendor too large ($VSZ > $VEND_MAX)"; exit 1; }
(( ISZ <= INIT_MAX )) || { log "rd_init too large ($ISZ > $INIT_MAX)"; exit 1; }

printf 'androidboot.googleboot=1\n' > "$W/bootconfig"

mkbootimg --header_version 4 --kernel "$VMLINUZ" --cmdline "" \
  --os_version 17.0.0 --os_patch_level 2026-09 -o "$W/boot_b.img"
mkbootimg --header_version 4 --ramdisk "$W/rd_init" \
  --os_version 17.0.0 --os_patch_level 2026-09 -o "$W/init_boot_b.img"
mkbootimg --header_version 4 --pagesize 0x800 --vendor_cmdline "$CMDLINE" \
  --vendor_bootconfig "$W/bootconfig" \
  --ramdisk_type platform --ramdisk_name '' --vendor_ramdisk_fragment "$W/rd_vendor" \
  --vendor_boot "$W/vendor_boot_b.img"

for pair in "boot_b.img:$BOOT_B" "init_boot_b.img:$INIT_B" "vendor_boot_b.img:$VEND_B"; do
  img="$W/${pair%%:*}"; dev="${pair#*:}"
  psz=$(blockdev --getsize64 "$dev"); isz=$(stat -c %s "$img")
  (( isz <= psz )) || { log "$img ($isz) larger than $dev ($psz)"; exit 1; }
  dd if="$img" of="$dev" bs=1M conv=fsync status=none
  h1=$(sha256sum "$img" | awk '{print $1}')
  h2=$(head -c "$isz" "$dev" | sha256sum | awk '{print $1}')
  [[ "$h1" == "$h2" ]] || { log "verify failed on $dev"; exit 1; }
  log "wrote $(basename "$img") -> $dev"
done

# Save backup copy of Slot B images & restore wrapper onto /boot (p11, unencrypted ext4)
# for restoring Linux Slot B (and promoting Android OTAs via googlebook-restore-slotb).
if [[ -d /boot ]]; then
  mkdir -p /boot/slotb-backup
  cp -f "$W/boot_b.img" "$W/init_boot_b.img" "$W/vendor_boot_b.img" /boot/slotb-backup/
  for rscript in "$SELF_DIR/bin/googlebook-restore-slotb" "/usr/local/bin/googlebook-restore-slotb" "/usr/share/omarchy/bin/googlebook-restore-slotb"; do
    if [[ -f "$rscript" ]]; then
      cp -f "$rscript" /boot/slotb-backup/googlebook-restore-slotb
      chmod 755 /boot/slotb-backup/googlebook-restore-slotb
      break
    fi
  done
  [[ -x /usr/local/bin/googleboot-menu ]] && cp -f /usr/local/bin/googleboot-menu /boot/slotb-backup/googleboot-menu || true
  # Keep the dracut log beside the images. It is the only record of what went into this
  # initramfs, $W is removed by the EXIT trap, and its warnings no longer reach the console
  # now that dracut's output is captured. ~30 KB, and the one thing worth having when Slot B
  # does not come up.
  [[ -s "$W/dracut.log" ]] && cp -f "$W/dracut.log" /boot/slotb-backup/dracut.log
  if [[ -s "$W/initramfs.list" ]]; then
    cp -f "$W/initramfs.list" /boot/slotb-backup/initramfs.list
  fi
  log "saved Slot B backup to /boot/slotb-backup"
fi

# kernel-install (Fedora/systemd) & postinst.d (Ubuntu/Debian) hooks so kernel updates refresh Slot B.
# Neither can fire on an image-based system: a kernel arrives there as a staged deployment
# rather than as a package transaction, and googlebook-slotb-sync.path repacks off the change
# to the Boot Loader Specification entries instead. Writing them anyway leaves files in the
# deployment's /etc - carried through every future ostree 3-way merge - for a code path that
# never runs. Nothing follows this section, so skipping it ends the run.
if (( OSTREE_DEPLOY )); then
  log "ostree deployment; kernel updates are repacked by googlebook-slotb-sync.path"
  log "done"
  exit 0
fi
HOOK=/etc/kernel/install.d/95-googlebook-slotb.install
if [[ ! -f "$HOOK" ]]; then
  mkdir -p /etc/kernel/install.d
  cat > "$HOOK" <<'EOF'
#!/bin/sh
# Refresh Googlebook Slot B (depthcharge) on kernel install
[ "$1" = "add" ] || exit 0
/usr/local/bin/googlebook-pack-slotb "$2" || true
EOF
  chmod +x "$HOOK"
fi
# Rewritten every run so existing installs pick up hook fixes.
POSTINST=/etc/kernel/postinst.d/zz-googlebook-slotb
mkdir -p /etc/kernel/postinst.d
cat > "$POSTINST" <<'EOF'
#!/bin/sh
# Refresh Googlebook Slot B (depthcharge) on Debian/Ubuntu kernel install
# kernel-install already ran 95-googlebook-slotb.install (Fedora's 95-kernel-hooks, systemd-boot); don't pack twice.
[ -n "$KERNEL_INSTALL_MACHINE_ID" ] && exit 0
[ -n "$1" ] && /usr/local/bin/googlebook-pack-slotb "$1" || true
EOF
chmod +x "$POSTINST"
if command -v pacman >/dev/null 2>&1 || [[ -d /etc/pacman.d ]]; then
  PACMAN_HOOK=/etc/pacman.d/hooks/95-googlebook-slotb.hook
  if [[ ! -f "$PACMAN_HOOK" ]]; then
    mkdir -p /etc/pacman.d/hooks
    cat > "$PACMAN_HOOK" <<'EOF'
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Refreshing Googlebook Slot B (depthcharge) boot images...
When = PostTransaction
Exec = /usr/local/bin/googlebook-pack-slotb
EOF
  fi
fi
log "done"
