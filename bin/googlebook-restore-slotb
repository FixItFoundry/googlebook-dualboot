#!/bin/sh
# Restore an existing Linux Slot B from backup. Never rewrites Slot A images or super.
# Usage: googlebook-restore-slotb [--fastboot [serial|tcp:IP] | --adb [serial]] [backup-dir] [--reboot]
# With no transport flag, run as root in Linux with /boot mounted.
# Android OTA promotion is unsupported; unknown/Android Slot B contents are refused.
set -eu

MODE=local
TARGET=""
BACKUP_DIR=""
DO_REBOOT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --fastboot|--adb)
      MODE=${1#--}; shift
      if [ $# -gt 0 ] && [ "${1#-}" = "$1" ] && [ ! -d "$1" ]; then
        TARGET=$1; shift
      fi ;;
    --reboot|-r) DO_REBOOT=1; shift ;;
    --no-promote) shift ;; # Compatibility only; never bypasses validation.
    --install-hook) echo 'Automatic OTA recovery is disabled; no hook installed.' >&2; exit 1 ;;
    -h|--help) sed -n '2,5s/^# //p' "$0"; exit 0 ;;
    *) [ -d "$1" ] && [ -z "$BACKUP_DIR" ] || { echo "Invalid argument: $1" >&2; exit 1; }
       BACKUP_DIR=$1; shift ;;
  esac
done

# Check the actual bootconfig offset, never an arbitrary prefix of the partition.
validate() {
  python3 - "$@" <<'PY'
import os, re, struct, sys

def vendor(path):
    with open(path, 'rb') as f:
        h = f.read(2128)
        if len(h) != 2128 or h[:8] != b'VNDRBOOT':
            raise ValueError('invalid vendor boot header')
        u32 = lambda offset: struct.unpack_from('<I', h, offset)[0]
        page = u32(12)
        if u32(8) != 4 or u32(2096) != 2128 or page not in (2048, 4096, 8192, 16384):
            raise ValueError('unsupported vendor boot layout')
        align = lambda n: (n + page - 1) // page * page
        table, count, entry, size = (u32(n) for n in (2112, 2116, 2120, 2124))
        if entry != 108 or table != count * entry or not 0 < size <= 65536:
            raise ValueError('invalid vendor ramdisk table or bootconfig size')
        offset = sum(align(n) for n in (2128, u32(24), u32(2100), table))
        if offset + size > 32 * 1024 * 1024:
            raise ValueError('bootconfig exceeds vendor partition')
        f.seek(offset)
        config = f.read(size)
        if len(config) != size or not re.search(rb'(?m)^androidboot\.(?:googleboot|fedomakase)=1\r?$', config):
            raise ValueError('Slot B is not positively identified as Linux; OTA recovery is unsupported')

def boot(path, limit, kernel):
    size = os.path.getsize(path)
    with open(path, 'rb') as f:
        h = f.read(1584)
    if len(h) != 1584 or h[:8] != b'ANDROID!' or not 4096 <= size <= limit:
        raise ValueError('invalid boot image size or magic')
    k, r = struct.unpack_from('<II', h, 8)
    if struct.unpack_from('<I', h, 20)[0] != 1584 or struct.unpack_from('<I', h, 40)[0] != 4:
        raise ValueError('expected Android boot image v4')
    if (kernel and not k) or (not kernel and (k or not r)):
        raise ValueError('wrong kernel/ramdisk image role')
    needed = 4096 + ((k + 4095) // 4096 + (r + 4095) // 4096) * 4096
    if size < needed:
        raise ValueError('truncated boot image')

try:
    if sys.argv[1] == 'vendor':
        vendor(sys.argv[2])
    else:
        directory = sys.argv[2]
        boot(os.path.join(directory, 'boot_b.img'), 64 * 1024 * 1024, True)
        boot(os.path.join(directory, 'init_boot_b.img'), 8 * 1024 * 1024, False)
        path = os.path.join(directory, 'vendor_boot_b.img')
        if not 2128 <= os.path.getsize(path) <= 32 * 1024 * 1024:
            raise ValueError('invalid vendor image size')
        vendor(path)
except (OSError, ValueError, struct.error) as e:
    sys.exit('Refusing restore: ' + str(e))
PY
}

command -v python3 >/dev/null || { echo 'Python 3 is required before any restore.' >&2; exit 1; }
[ -n "$BACKUP_DIR" ] || { if [ "$MODE" = local ]; then BACKUP_DIR=/boot/slotb-backup; else BACKUP_DIR=./slotb-backup; fi; }
validate backup "$BACKUP_DIR"

if [ "$MODE" = adb ]; then
  adb_cmd() { if [ -n "$TARGET" ]; then adb -s "$TARGET" "$@"; else adb "$@"; fi; }
  SERIAL=$(adb_cmd shell getprop ro.serialno | tr -d '\r\n')
  case "$SERIAL" in ''|*[!a-zA-Z0-9._-]*) echo 'Cannot determine a unique USB Fastboot serial; use --fastboot explicitly.' >&2; exit 1 ;; esac
  adb_cmd reboot bootloader
  TARGET=$SERIAL
  MODE=fastboot
fi

if [ "$MODE" = fastboot ]; then
  fb() { if [ -n "$TARGET" ]; then fastboot -s "$TARGET" "$@"; else fastboot "$@"; fi; }
  WORK=$(mktemp -d)
  trap 'rm -rf "$WORK"' EXIT
  # A/B selection says nothing about the OS; require a readable Linux vendor image.
  if ! fb fetch vendor_boot_b "$WORK/vendor_boot_b.img"; then
    echo 'Cannot verify Slot B. This device must support Fastboot fetch; no partitions flashed.' >&2
    exit 1
  fi
  validate vendor "$WORK/vendor_boot_b.img"
  for name in boot_b init_boot_b vendor_boot_b; do
    info=$(fb getvar "partition-size:$name" 2>&1)
    capacity=$(printf '%s\n' "$info" | sed -n "s/.*partition-size:$name: *\(0x[0-9a-fA-F]*\).*/\1/p")
    python3 - "$capacity" "$BACKUP_DIR/$name.img" <<'PY_SIZE'
import os, sys
try:
    if os.path.getsize(sys.argv[2]) > int(sys.argv[1], 16):
        raise ValueError('image exceeds partition')
except ValueError as e:
    sys.exit('Invalid partition size: ' + str(e))
PY_SIZE
  done
  for name in boot_b init_boot_b vendor_boot_b; do
    fb flash "$name" "$BACKUP_DIR/$name.img"
  done
  fb --set-active=b
  if [ "$DO_REBOOT" = 1 ]; then fb reboot; fi
else
  [ "$(id -u)" = 0 ] || { echo 'Run with sudo from Linux.' >&2; exit 1; }
  command -v sgdisk >/dev/null || { echo 'sgdisk is required before restoring.' >&2; exit 1; }
  for pair in 14:boot_b 19:init_boot_b 21:vendor_boot_b 15:vbmeta_a 16:vbmeta_b 13:boot_a; do
    dev="/dev/nvme0n1p${pair%%:*}"
    [ -b "$dev" ] && [ "$(lsblk -dnro PARTLABEL "$dev")" = "${pair#*:}" ] || {
      echo "Unexpected partition layout at $dev; refusing restore." >&2; exit 1;
    }
  done
  validate vendor /dev/nvme0n1p21
  for pair in 14:boot_b 19:init_boot_b 21:vendor_boot_b; do
    size=$(wc -c < "$BACKUP_DIR/${pair#*:}.img")
    [ "$size" -le "$(blockdev --getsize64 "/dev/nvme0n1p${pair%%:*}")" ] || {
      echo 'Backup exceeds target partition; no images written.' >&2; exit 1;
    }
  done
  for pair in 14:boot_b 19:init_boot_b 21:vendor_boot_b; do
    dd if="$BACKUP_DIR/${pair#*:}.img" of="/dev/nvme0n1p${pair%%:*}" bs=1048576 conv=fsync
  done
  sgdisk --attributes=15:=0001000000000000 --attributes=16:=0102000000000000 \
         --attributes=13:=0001000000000000 --attributes=14:=0102000000000000 /dev/nvme0n1
  if [ "$DO_REBOOT" = 1 ]; then reboot; fi
fi
echo 'Linux Slot B restored. Slot A, super and vbmeta image contents were not rewritten.'
