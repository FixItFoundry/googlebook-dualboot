#!/bin/sh
# googlebook-sysroot-sync
# Distro-agnostic Slot B initramfs hook that runs after /sysroot is mounted
# (Before=initrd-switch-root.target).
# Syncs Acer Googlebook 14 (Moonstone) Coreboot framebuffer modules, Intel
# Panther Lake Xe2 staged GPU load rules, Vivaldi top-row action key hwdb/keyd
# mappings, and Slot A/B switch tools into the target Linux rootfs (/sysroot).

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/sysroot/usr/sbin:/sysroot/usr/bin"

mount -o remount,rw /sysroot 2>/dev/null || true

# 1. Install coreboot framebuffer modules, SoundWire audio modules & GPU staging rules into /sysroot
KVER=$(uname -r)
if [ -d "/sysroot/lib/modules/$KVER" ]; then
  mkdir -p "/sysroot/lib/modules/$KVER/extra" "/sysroot/lib/modules/$KVER/updates"
  cp -f "/lib/modules/$KVER/extra"/*.ko /usr/local/lib/googlebook-mods/*.ko "/sysroot/lib/modules/$KVER/extra/" 2>/dev/null || true
  cp -f /usr/local/lib/googlebook-audio-mods/*.ko "/sysroot/lib/modules/$KVER/updates/" 2>/dev/null || true
  chroot /sysroot depmod -a "$KVER" 2>/dev/null || true
fi

# Keep the board firmware and bridge source available after switching root.
if [ -d /usr/local/share/googlebook-sensors ]; then
  mkdir -p /sysroot/usr/local/share/googlebook-sensors /sysroot/lib/firmware/intel/ish
  cp -a /usr/local/share/googlebook-sensors/. /sysroot/usr/local/share/googlebook-sensors/ || exit 1
  cp /usr/local/share/googlebook-sensors/firmware/intel/ish/ish_ptl_62b0f067_501de2f8.bin \
    /sysroot/lib/firmware/intel/ish/ || exit 1
fi

if [ -d /usr/local/share/googlebook-audio/firmware ]; then
  mkdir -p /sysroot/lib/firmware/realtek/rt1320
  cp -f /usr/local/share/googlebook-audio/firmware/*.dat /sysroot/lib/firmware/realtek/rt1320/ 2>/dev/null || true
fi

if [ -d /sysroot/usr/share/alsa/ucm2 ]; then
  mkdir -p /sysroot/usr/share/alsa/ucm2/codecs/rt721+rt1320
  cat > /sysroot/usr/share/alsa/ucm2/codecs/rt721+rt1320/init.conf << 'UCMEOF'
# RT721 + RT1320 combo speaker specific volume control settings

FixedBootSequence [
	msleep 200
	cset "name='rt1320-1 Brown Out Switch' 0"
	cset "name='rt1320-1 RAE Update' 1"
	cset "name='rt1320-1 FU21 Playback Volume' 87"
]

BootSequence [
	cset "name='rt1320-1 Brown Out Switch' 0"
	cset "name='rt1320-1 RAE Update' 1"
	cset "name='rt1320-1 FU21 Playback Volume' 87"
	cset "name='rt1320-1 OT23 L Switch' 0"
	cset "name='rt1320-1 OT23 R Switch' 0"
	cset "name='Speaker Switch' 0,0"
]
UCMEOF
  if [ -f /sysroot/usr/share/alsa/ucm2/sof-soundwire/rt721.conf ]; then
    sed -i 's/Regex "(rt721(-sdca)?)"/Regex "^(rt721(-sdca)?)$"/' /sysroot/usr/share/alsa/ucm2/sof-soundwire/rt721.conf 2>/dev/null || true
  fi
fi

mkdir -p /sysroot/etc/modules-load.d /sysroot/etc/modprobe.d
printf "coreboot_table\nframebuffer-coreboot\n" > /sysroot/etc/modules-load.d/coreboot-fb.conf
rm -f /sysroot/etc/modprobe.d/googlebook-no-xe.conf
cat > /sysroot/etc/modprobe.d/googlebook-xe-staged.conf << 'XEEOF'
blacklist i915
blacklist xe
options xe gsc_firmware_path="" huc_firmware_path="" wedged_mode=0 enable_psr=0
options spi_intel_pci writeable=1
XEEOF

# 2. Install Googlebook Slot A/B switch utility, googleboot-menu binary, udev rules, and sudoers
mkdir -p /sysroot/usr/local/bin /sysroot/usr/local/sbin /sysroot/etc/udev/rules.d /sysroot/etc/sudoers.d
for bin_name in googlebook-switch-slot googleboot-menu googleboot-scan googlebook-restore-slotb; do
  if [ -f "/usr/local/bin/$bin_name" ]; then
    # Absolute symlinks (e.g. to /usr/share/omarchy/bin) dangle in initramfs and make cp refuse.
    rm -f "/sysroot/usr/local/bin/$bin_name"
    cp -f "/usr/local/bin/$bin_name" "/sysroot/usr/local/bin/$bin_name"
    chmod 755 "/sysroot/usr/local/bin/$bin_name"
  fi
done
if [ -f /sysroot/boot/slotb-backup/googlebook-restore-slotb ] && [ ! -f /sysroot/usr/local/bin/googlebook-restore-slotb ]; then
  cp -f /sysroot/boot/slotb-backup/googlebook-restore-slotb /sysroot/usr/local/bin/googlebook-restore-slotb
  chmod 755 /sysroot/usr/local/bin/googlebook-restore-slotb
fi
ln -sf /usr/local/bin/googlebook-switch-slot /sysroot/usr/local/bin/boot-android

# Remove legacy grants; slot switching uses the administrator's normal sudo policy.
rm -f /sysroot/etc/udev/rules.d/99-googlebook-slotb.rules /sysroot/etc/sudoers.d/googlebook-slotb

# 3. Install Moonstone Vivaldi top-row keyboard hwdb and keyd mappings
mkdir -p /sysroot/etc/keyd /sysroot/etc/udev/hwdb.d
cat > /sysroot/etc/udev/hwdb.d/61-googlebook-moonstone.hwdb << 'HWDBEOF'
evdev:atkbd:dmi:bvn*:bvr*:bd*:svnGoogle:pnMoonstone*
 KEYBOARD_KEY_91=f11
 KEYBOARD_KEY_9b=f20
 KEYBOARD_KEY_a7=playpause
 KEYBOARD_KEY_a9=prog1
HWDBEOF
chroot /sysroot systemd-hwdb update 2>/dev/null || true

cat > /sysroot/etc/keyd/cros.conf << 'KEYDEOF'
[ids]
0001:0001
18d1:*

[main]
zoom = f11
micmute = f20

[meta]
back = f1
homepage = f2
refresh = f2
scale = f3
zoom = f4
sysrq = f5
brightnessdown = f6
brightnessup = f7
kbdillumtoggle = f8
micmute = f9
playpause = f10
mute = f10
volumedown = f11
volumeup = f12
KEYDEOF

# 4. Install googlebook-gpu-init.service to load Intel Xe2 driver before display-manager.service
cat > /sysroot/usr/local/sbin/googlebook-gpu-init << 'GPUEOF'
#!/bin/sh
modprobe coreboot_table 2>/dev/null || true
modprobe framebuffer-coreboot 2>/dev/null || true

# Map Moonstone Vivaldi top-row scancodes >247 (0x91 Fullscreen -> 87 F11, 0x9B MicMute -> 190 F20, 0xA7 Access -> 164 PlayPause)
if command -v python3 >/dev/null 2>&1; then
  python3 - << 'PY' 2>/dev/null || true
import fcntl, glob, struct
EVIOCSKEYCODE = 0x40084504
for dev in glob.glob("/dev/input/by-path/*i8042-serio-0-event-kbd"):
    with open(dev, "wb") as fd:
        for sc, kc in [(0x91, 87), (0x9B, 190), (0xA7, 164)]:
            try:
                fcntl.ioctl(fd, EVIOCSKEYCODE, struct.pack("II", sc, kc))
            except Exception:
                pass
PY
fi

if [ ! -e /dev/dri/renderD128 ]; then
  modprobe xe gsc_firmware_path="" huc_firmware_path="" wedged_mode=0 enable_psr=0 2>/dev/null || true
fi

# If Linux was staged into Slot A after an Android OTA, promote the verified Android OTA
# from Slot B -> Slot A and restore Linux to Slot B automatically.
if [ -f /usr/local/bin/googlebook-restore-slotb ]; then
  if [ -d /boot/slotb-backup ]; then
    cp -f /usr/local/bin/googlebook-restore-slotb /boot/slotb-backup/googlebook-restore-slotb 2>/dev/null || true
    chmod 755 /boot/slotb-backup/googlebook-restore-slotb 2>/dev/null || true
  fi
  /bin/sh /usr/local/bin/googlebook-restore-slotb --auto-post-ota >>/run/googlebook-restore-slotb.log 2>&1 || true
fi

exit 0
GPUEOF
chmod 755 /sysroot/usr/local/sbin/googlebook-gpu-init
chroot /sysroot chcon --reference=/usr/bin/sh /usr/local/bin/googlebook-switch-slot /usr/local/bin/googleboot-menu /usr/local/bin/googleboot-scan /usr/local/bin/googlebook-restore-slotb /usr/local/sbin/googlebook-gpu-init 2>/dev/null || true

# Run post-OTA promotion (Slot B -> Slot A) immediately during initramfs sync if Linux is staged in Slot A
if [ -f /sysroot/usr/local/bin/googlebook-restore-slotb ]; then
  MOUNTED_DEV=0; MOUNTED_PROC=0; MOUNTED_SYS=0; MOUNTED_RUN=0
  if [ ! -b /sysroot/dev/nvme0n1 ]; then mount --bind /dev /sysroot/dev 2>/dev/null && MOUNTED_DEV=1 || true; fi
  if [ ! -e /sysroot/proc/mounts ]; then mount --bind /proc /sysroot/proc 2>/dev/null && MOUNTED_PROC=1 || true; fi
  if [ ! -d /sysroot/sys/class/block ]; then mount --bind /sys /sysroot/sys 2>/dev/null && MOUNTED_SYS=1 || true; fi
  if [ ! -d /sysroot/run/udev ]; then mount --bind /run /sysroot/run 2>/dev/null && MOUNTED_RUN=1 || true; fi
  chroot /sysroot /bin/sh /usr/local/bin/googlebook-restore-slotb --auto-post-ota >>/run/googlebook-restore-slotb.log 2>&1 || true
  [ "$MOUNTED_RUN" = 1 ] && umount /sysroot/run 2>/dev/null || true
  [ "$MOUNTED_SYS" = 1 ] && umount /sysroot/sys 2>/dev/null || true
  [ "$MOUNTED_PROC" = 1 ] && umount /sysroot/proc 2>/dev/null || true
  [ "$MOUNTED_DEV" = 1 ] && umount /sysroot/dev 2>/dev/null || true
fi

mkdir -p /sysroot/etc/systemd/system/multi-user.target.wants /sysroot/etc/systemd/system/graphical.target.wants
cat > /sysroot/etc/systemd/system/googlebook-gpu-init.service << 'SVCEOF'
[Unit]
Description=GoogleBook Moonstone Display & Keyboard Hardware Init
After=systemd-modules-load.service systemd-udevd.service local-fs.target
Before=display-manager.service gdm.service sddm.service lightdm.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/googlebook-gpu-init
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target graphical.target
SVCEOF

ln -sf ../googlebook-gpu-init.service /sysroot/etc/systemd/system/multi-user.target.wants/googlebook-gpu-init.service
ln -sf ../googlebook-gpu-init.service /sysroot/etc/systemd/system/graphical.target.wants/googlebook-gpu-init.service

exit 0
