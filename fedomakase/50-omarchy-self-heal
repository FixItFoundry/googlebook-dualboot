#!/bin/sh
# 50-omarchy-self-heal: Fedomakase add-on for googlebook-sysroot-sync.
# Install to /etc/googlebook/sysroot-sync.d/; googlebook-pack-slotb packs it into the
# Slot B initramfs and the sync runs it after /sysroot is mounted.
# Repairs Omarchy Quattro (Hyprland + SDDM + UWSM) system and user configuration, and
# provisions users in the real root before SDDM starts.

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/sysroot/usr/sbin:/sysroot/usr/bin"

# 1. Locate /sysroot backing block device without awk & mount Btrfs subvol=home at /sysroot/home
HOME_MOUNTED_BY_SYNC=0
ROOT_DEV=""
while IFS=' ' read -r m_dev m_mp _rest; do
  if [ "$m_mp" = "/sysroot" ]; then
    ROOT_DEV="$m_dev"
    break
  fi
done < /proc/mounts

if [ -z "$ROOT_DEV" ]; then
  for d in /dev/mapper/luks-*; do
    [ -b "$d" ] && { ROOT_DEV="$d"; break; }
  done
fi

HOME_ALREADY_MOUNTED=0
while IFS=' ' read -r _dev m_mp _rest; do
  if [ "$m_mp" = "/sysroot/home" ]; then
    HOME_ALREADY_MOUNTED=1
    break
  fi
done < /proc/mounts

if [ -n "$ROOT_DEV" ] && [ "$HOME_ALREADY_MOUNTED" = "0" ]; then
  mkdir -p /sysroot/home
  if mount -t btrfs -o subvol=home "$ROOT_DEV" /sysroot/home 2>/dev/null; then
    HOME_MOUNTED_BY_SYNC=1
  fi
fi

# 2. Detect primary human user (UID >= 1000 && UID < 60000) using pure POSIX read (no awk needed)
PRIMARY_USER=""
if [ -f /sysroot/etc/passwd ]; then
  while IFS=: read -r p_user _pw p_uid _gid _gecos _home _shell; do
    case "$p_uid" in
      ''|*[!0-9]*) continue ;;
    esac
    if [ "$p_uid" -ge 1000 ] && [ "$p_uid" -lt 60000 ] && [ "$p_user" != "nobody" ] && [ "$p_user" != "nfsnobody" ]; then
      PRIMARY_USER="$p_user"
      break
    fi
  done < /sysroot/etc/passwd
fi
if [ -z "$PRIMARY_USER" ]; then
  for d in /sysroot/home/*; do
    [ -d "$d" ] || continue
    bn="${d##*/}"
    [ "$bn" = "lost+found" ] && continue
    PRIMARY_USER="$bn"
    break
  done
fi
[ -z "$PRIMARY_USER" ] && PRIMARY_USER="jcasco"

get_uid_gid() {
  target_u="$1"
  passwd_file="$2"
  res_ug=""
  if [ -f "$passwd_file" ]; then
    while IFS=: read -r p_user _pw p_uid p_gid _rest; do
      if [ "$p_user" = "$target_u" ]; then
        res_ug="${p_uid}:${p_gid}"
        break
      fi
    done < "$passwd_file"
  fi
  [ -z "$res_ug" ] && res_ug="1000:1000"
  echo "$res_ug"
}

# 3. Ensure SELinux is permissive so unlabeled initramfs-synced files (/etc/shadow, SDDM, ~/.config)
#    never cause PAM (unix_chkpwd) or SDDM to reject the user's password!
if [ -f /sysroot/etc/selinux/config ]; then
  sed -i 's/^SELINUX=enforcing/SELINUX=permissive/' /sysroot/etc/selinux/config 2>/dev/null || true
fi


# 6. Self-heal Omarchy Quattro system & user configuration on /sysroot
repair_omarchy_tree() {
  R="$1"
  if [ ! -f "$R/usr/share/omarchy/default/hypr/bootstrap.lua" ] && [ -d /usr/share/omarchy-seed ]; then
    mkdir -p "$R/usr/share/omarchy"
    cp -a /usr/share/omarchy-seed/. "$R/usr/share/omarchy/" 2>/dev/null || true
    if [ -d /usr/share/omarchy-seed/etc ]; then
      cp -rn /usr/share/omarchy-seed/etc/* "$R/etc/" 2>/dev/null || true
      cp -rf /usr/share/omarchy-seed/etc/sddm.conf.d "$R/etc/" 2>/dev/null || true
    fi
  fi
  [ -d "$R/usr/share/omarchy" ] || return 0

  chmod +x "$R/usr/share/omarchy/bin/"* "$R/usr/share/omarchy/installer/"* 2>/dev/null || true
  mkdir -p "$R/usr/bin" "$R/usr/local/bin"
  for f in "$R/usr/share/omarchy/bin/"*; do
    [ -f "$f" ] || continue
    bn="${f##*/}"
    ln -sf "/usr/share/omarchy/bin/$bn" "$R/usr/bin/$bn"
    ln -sf "/usr/share/omarchy/bin/$bn" "$R/usr/local/bin/$bn"
  done

  if [ -f "$R/usr/share/omarchy/default/bash/env-bootstrap" ]; then
    cat > "$R/usr/share/omarchy/default/bash/env-bootstrap" << 'ENVBOOTEOF'
# System-wide Omarchy environment bootstrap.
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
case ":$PATH:" in
  *":${OMARCHY_PATH%/}/bin:"*) ;;
  *) export PATH="${OMARCHY_PATH%/}/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) [ -n "${HOME:-}" ] && export PATH="$HOME/.local/bin:$PATH" ;;
esac
ENVBOOTEOF
    chmod 644 "$R/usr/share/omarchy/default/bash/env-bootstrap"
    mkdir -p "$R/etc/profile.d"
    ln -sf /usr/share/omarchy/default/bash/env-bootstrap "$R/etc/profile.d/omarchy.sh"
  fi

  mkdir -p "$R/usr/share/uwsm/env.d" "$R/usr/share/uwsm/modules"
  if [ -d /usr/share/omarchy-seed/uwsm-xdg ] && [ ! -d "$R/usr/lib/python3.14/site-packages/xdg" ]; then
    cp -rf /usr/share/omarchy-seed/uwsm-xdg "$R/usr/share/uwsm/modules/xdg" 2>/dev/null || true
  fi
  if [ -d "$R/etc/systemd/user" ] && [ -d /usr/share/omarchy-seed/etc/systemd/user ]; then
    cp -rf /usr/share/omarchy-seed/etc/systemd/user/. "$R/etc/systemd/user/" 2>/dev/null || true
  fi
  if [ -f "$R/usr/share/omarchy/default/uwsm/default" ]; then
    cp -f "$R/usr/share/omarchy/default/uwsm/default" "$R/usr/share/uwsm/default"
  else
    cat > "$R/usr/share/uwsm/default" << 'UWSMEOF'
export OMARCHY_PATH=/usr/share/omarchy
export PATH=$OMARCHY_PATH/bin:$PATH:$HOME/.local/bin
export TERMINAL=xdg-terminal-exec
UWSMEOF
  fi
  cat > "$R/usr/share/uwsm/env.d/10-omarchy" << 'UWSMENVEOF'
# Preload Omarchy session runtime defaults into the uwsm environment.
[ -r /usr/share/omarchy/default/bash/env-bootstrap ] && . /usr/share/omarchy/default/bash/env-bootstrap
[ -r /usr/share/omarchy/default/uwsm/default ] && . /usr/share/omarchy/default/uwsm/default

if command -v omarchy-Runtime-env >/dev/null 2>&1; then
  eval "$(omarchy-Runtime-env)" || true
fi

if command -v omarchy-cmd-present >/dev/null 2>&1 && omarchy-cmd-present mise; then
  eval "$(mise activate bash --shims)" || true
fi
true
UWSMENVEOF
  chmod 644 "$R/usr/share/uwsm/default" "$R/usr/share/uwsm/env.d/10-omarchy"

  if [ -d "$R/usr/share/omarchy/default/environment.d" ]; then
    mkdir -p "$R/usr/lib/environment.d"
    cp -f "$R/usr/share/omarchy/default/environment.d/"*.conf "$R/usr/lib/environment.d/" 2>/dev/null || true
  fi

  mkdir -p "$R/usr/share/sddm/themes"
  if [ -f "$R/usr/share/omarchy/default/sddm/hyprland.lua" ]; then
    cp -f "$R/usr/share/omarchy/default/sddm/hyprland.lua" "$R/usr/share/sddm/hyprland.lua"
    chmod 644 "$R/usr/share/sddm/hyprland.lua"
  fi
  if [ -d "$R/usr/share/omarchy/default/sddm/omarchy" ]; then
    cp -rf "$R/usr/share/omarchy/default/sddm/omarchy" "$R/usr/share/sddm/themes/"
  fi
  rm -rf "$R/var/lib/sddm/.config/hypr" 2>/dev/null || true

  if [ -d "$R/usr/share/omarchy/default/wayland-sessions" ]; then
    mkdir -p "$R/usr/share/wayland-sessions"
    cp -rf "$R/usr/share/omarchy/default/wayland-sessions/." "$R/usr/share/wayland-sessions/"
    rm -f "$R/usr/share/wayland-sessions/hyprland-uwsm.desktop" 2>/dev/null || true
  fi

  if [ -f "$R/usr/share/omarchy/bin/omarchy-apply-fedora-patches" ]; then
    sed -i 's|CompositorCommand=uwsm start -e -D Hyprland hyprland.desktop|CompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.lua|g' "$R/usr/share/omarchy/bin/omarchy-apply-fedora-patches" 2>/dev/null || true
    sed -i 's|CompositorCommand=Hyprland --config /usr/share/sddm/hyprland.lua|CompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.lua|g' "$R/usr/share/omarchy/bin/omarchy-apply-fedora-patches" 2>/dev/null || true
    sed -i 's|grep -q "uwsm start" "\$sddm_wayland"|grep -q "/usr/share/sddm/hyprland.lua" "\$sddm_wayland"|g' "$R/usr/share/omarchy/bin/omarchy-apply-fedora-patches" 2>/dev/null || true
  fi

  if [ -f "$R/usr/share/omarchy/install/user/mise-work.sh" ]; then
    sed -i 's/exit 1/echo "Warning: Node.js tarball not bundled; skipping offline Node install" >\&2/' "$R/usr/share/omarchy/install/user/mise-work.sh" 2>/dev/null || true
  fi
  if [ -f "$R/usr/share/omarchy/install/user/mise.sh" ]; then
    sed -i 's/\(omarchy-mise-install .*\)/\1 || true/' "$R/usr/share/omarchy/install/user/mise.sh" 2>/dev/null || true
    sed -i 's/^mise reshim$/mise reshim || true/' "$R/usr/share/omarchy/install/user/mise.sh" 2>/dev/null || true
  fi

  mkdir -p "$R/etc/sddm.conf.d" "$R/var/lib/sddm"
  cat > "$R/etc/sddm.conf.d/10-wayland.conf" << 'WLEOF'
[General]
DisplayServer=wayland

[Wayland]
CompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.lua
SessionDir=/usr/share/wayland-sessions

[Theme]
Current=omarchy
WLEOF

  cat > "$R/etc/sddm.conf.d/autologin.conf" << AUTOEOF
[Autologin]
User=${PRIMARY_USER}
Session=omarchy.desktop
Relogin=false
AUTOEOF
  cp -f "$R/etc/sddm.conf.d/autologin.conf" "$R/etc/sddm.conf.d/omarchy.conf" 2>/dev/null || true

  cat > "$R/var/lib/sddm/state.conf" << STATEEOF
[Last]
User=${PRIMARY_USER}
Session=/usr/share/wayland-sessions/omarchy.desktop
STATEEOF

  mkdir -p "$R/etc/skel/.config/omarchy/branding" \
           "$R/etc/skel/.config/autostart" \
           "$R/etc/skel/.local/state/omarchy/toggles/hypr" \
           "$R/etc/skel/.local/state/tensaku" \
           "$R/etc/skel/.local/share/nautilus-python/extensions"
  cp -rf "$R/usr/share/omarchy/config/." "$R/etc/skel/.config/" 2>/dev/null || true
  cp -f "$R/usr/share/omarchy/default/bashrc" "$R/etc/skel/.bashrc" 2>/dev/null || true
  cp -f "$R/usr/share/omarchy/logo.txt" "$R/etc/skel/.config/omarchy/branding/screensaver.txt" 2>/dev/null || true
  cp -f "$R/usr/share/omarchy/logo.txt" "$R/etc/skel/.config/omarchy/branding/about.txt" 2>/dev/null || true
  cp -f "$R/usr/share/omarchy/default/hypr/toggles/flags.lua" "$R/etc/skel/.local/state/omarchy/toggles/hypr/flags.lua" 2>/dev/null || true
  cp -f "$R/usr/share/omarchy/default/tensaku/state.toml" "$R/etc/skel/.local/state/tensaku/state.toml" 2>/dev/null || true
  cp -f "$R/usr/share/omarchy/default/nautilus-python/extensions/localsend.py" "$R/etc/skel/.local/share/nautilus-python/extensions/localsend.py" 2>/dev/null || true
  cat > "$R/etc/skel/.config/autostart/omarchy-first-run.desktop" << 'AUTOSTART_EOF'
[Desktop Entry]
Type=Application
Name=Omarchy First Run Setup
Exec=/usr/share/omarchy/bin/omarchy-provision-first-run
Hidden=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
AUTOSTART_EOF
  chmod -R a+rX "$R/etc/skel" 2>/dev/null || true

  # Ensure primary user's home directory exists on /sysroot/home
  mkdir -p "$R/home/$PRIMARY_USER"

  for user_dir in "$R/home/"*; do
    [ -d "$user_dir" ] || continue
    user_name="${user_dir##*/}"
    [ "$user_name" = "lost+found" ] && continue

    uid_gid=$(get_uid_gid "$user_name" "$R/etc/passwd")

    rm -f "$user_dir/.config/hypr/hyprland.conf" 2>/dev/null || true

    if [ ! -f "$user_dir/.config/hypr/hyprland.lua" ] || \
       ! grep -q "default/hypr/bootstrap.lua" "$user_dir/.config/hypr/hyprland.lua" 2>/dev/null || \
       [ ! -f "$user_dir/.config/hypr/autostart.lua" ]; then
      mkdir -p "$user_dir/.config"
      cp -rf "$R/usr/share/omarchy/config/." "$user_dir/.config/"
    fi

    mkdir -p "$user_dir/.config/omarchy/branding" \
             "$user_dir/.config/autostart" \
             "$user_dir/.local/state/omarchy/toggles/hypr" \
             "$user_dir/.local/state/tensaku" \
             "$user_dir/.local/share/nautilus-python/extensions" \
             "$user_dir/.local/share/applications" \
             "$user_dir/.local/share/icons"
    if [ ! -f "$user_dir/.bashrc" ] || ! grep -q "omarchy" "$user_dir/.bashrc" 2>/dev/null; then
      cp -f "$R/usr/share/omarchy/default/bashrc" "$user_dir/.bashrc" 2>/dev/null || true
    fi
    [ -f "$user_dir/.config/omarchy/branding/screensaver.txt" ] || cp -f "$R/usr/share/omarchy/logo.txt" "$user_dir/.config/omarchy/branding/screensaver.txt" 2>/dev/null || true
    [ -f "$user_dir/.config/omarchy/branding/about.txt" ] || cp -f "$R/usr/share/omarchy/logo.txt" "$user_dir/.config/omarchy/branding/about.txt" 2>/dev/null || true
    [ -f "$user_dir/.local/state/omarchy/toggles/hypr/flags.lua" ] || cp -f "$R/usr/share/omarchy/default/hypr/toggles/flags.lua" "$user_dir/.local/state/omarchy/toggles/hypr/flags.lua" 2>/dev/null || true
    [ -f "$user_dir/.local/state/tensaku/state.toml" ] || cp -f "$R/usr/share/omarchy/default/tensaku/state.toml" "$user_dir/.local/state/tensaku/state.toml" 2>/dev/null || true
    [ -f "$user_dir/.local/share/nautilus-python/extensions/localsend.py" ] || cp -f "$R/usr/share/omarchy/default/nautilus-python/extensions/localsend.py" "$user_dir/.local/share/nautilus-python/extensions/localsend.py" 2>/dev/null || true
    [ -f "$user_dir/.config/autostart/omarchy-first-run.desktop" ] || cp -f "$R/etc/skel/.config/autostart/omarchy-first-run.desktop" "$user_dir/.config/autostart/omarchy-first-run.desktop" 2>/dev/null || true

    if [ -d "$R/usr/share/omarchy/applications" ]; then
      cp -rf "$R/usr/share/omarchy/applications/"*.desktop "$user_dir/.local/share/applications/" 2>/dev/null || true
      cp -rf "$R/usr/share/omarchy/applications/icons/." "$user_dir/.local/share/icons/" 2>/dev/null || true
    fi

    if [ ! -f "$user_dir/.local/state/omarchy/current/theme/hyprland.lua" ] && [ -d "$R/usr/share/omarchy/themes/tokyo-night" ]; then
      mkdir -p "$user_dir/.local/state/omarchy/current/theme" \
               "$user_dir/.config/btop/themes" \
               "$user_dir/.config/mako" \
               "$user_dir/.config/eza"
      cp -rf "$R/usr/share/omarchy/themes/tokyo-night/." "$user_dir/.local/state/omarchy/current/theme/"
      printf 'tokyo-night\n' > "$user_dir/.local/state/omarchy/current/theme.name"
      first_bg=""
      for bg_cand in "$user_dir/.local/state/omarchy/current/theme/backgrounds/"*; do
        [ -f "$bg_cand" ] && { first_bg="$bg_cand"; break; }
      done
      if [ -n "$first_bg" ]; then
        bg_bn="${first_bg##*/}"
        ln -snf "/home/$user_name/.local/state/omarchy/current/theme/backgrounds/$bg_bn" "$user_dir/.local/state/omarchy/current/background"
      fi
      [ -f "$user_dir/.local/state/omarchy/current/theme/btop.theme" ] && cp -f "$user_dir/.local/state/omarchy/current/theme/btop.theme" "$user_dir/.config/btop/themes/current.theme"
      [ -f "$user_dir/.local/state/omarchy/current/theme/mako.ini" ] && cp -f "$user_dir/.local/state/omarchy/current/theme/mako.ini" "$user_dir/.config/mako/config"
      [ -f "$user_dir/.local/state/omarchy/current/theme/eza.yml" ] && cp -f "$user_dir/.local/state/omarchy/current/theme/eza.yml" "$user_dir/.config/eza/theme.yml"
    fi

    # Baseline migrations only for a new user, as the Omarchy installer does; later ones must still run.
    if [ -d "$R/usr/share/omarchy/migrations" ] && [ ! -d "$user_dir/.local/state/omarchy/migrations" ]; then
      mkdir -p "$user_dir/.local/state/omarchy/migrations"
      for mig in "$R/usr/share/omarchy/migrations/"*.sh; do
        [ -f "$mig" ] || continue
        touch "$user_dir/.local/state/omarchy/migrations/${mig##*/}"
      done
    fi

    if [ -d "$R/usr/share/omarchy/fedora-patches" ]; then
      mkdir -p "$user_dir/.local/share/fedomakase/bin" "$user_dir/.local/share/fedomakase/fedora-patches" "$user_dir/.config/omarchy/hooks/post-update.d"
      cp -f "$R/usr/share/omarchy/bin/omarchy-apply-fedora-patches" "$user_dir/.local/share/fedomakase/bin/" 2>/dev/null || true
      cp -rf "$R/usr/share/omarchy/fedora-patches/." "$user_dir/.local/share/fedomakase/fedora-patches/" 2>/dev/null || true
      cp -f "$R/usr/share/omarchy/fedora-patches/apply-fedora-patches.hook" "$user_dir/.config/omarchy/hooks/post-update.d/apply-fedora-patches.hook" 2>/dev/null || true
      chmod +x "$user_dir/.config/omarchy/hooks/post-update.d/apply-fedora-patches.hook" 2>/dev/null || true
    fi

    # Hand back only what this root-run sync created; leave files owned by other uids alone.
    chroot "$R" find "/home/$user_name" -xdev -user 0 -exec chown -h "$uid_gid" {} + 2>/dev/null || true
  done
}

repair_omarchy_tree /sysroot

# Real-root user provisioning before SDDM (needs /home and the installed Omarchy tree).
mkdir -p /sysroot/usr/local/sbin
cat > /sysroot/usr/local/sbin/fedomakase-user-heal << 'HEALEOF'
#!/bin/sh
setenforce 0 2>/dev/null || true
restorecon -F /etc/shadow /etc/passwd /etc/group 2>/dev/null || true
for user_dir in /home/*; do
  [ -d "$user_dir" ] || continue
  user_name="${user_dir##*/}"
  [ "$user_name" = "lost+found" ] && continue
  uid_gid="1000:1000"
  while IFS=: read -r p_u _pw p_uid p_gid _rest; do
    [ "$p_u" = "$user_name" ] && { uid_gid="${p_uid}:${p_gid}"; break; }
  done < /etc/passwd

  rm -f "$user_dir/.config/hypr/hyprland.conf" 2>/dev/null || true
  if [ ! -f "$user_dir/.config/hypr/hyprland.lua" ] || \
     ! grep -q "default/hypr/bootstrap.lua" "$user_dir/.config/hypr/hyprland.lua" 2>/dev/null || \
     [ ! -f "$user_dir/.config/hypr/autostart.lua" ]; then
    if [ -d /usr/share/omarchy/config ]; then
      mkdir -p "$user_dir/.config"
      cp -rf /usr/share/omarchy/config/. "$user_dir/.config/"
      cp -rf /etc/skel/. "$user_dir/" 2>/dev/null || true
    fi
  fi

  if [ ! -f "$user_dir/.local/state/omarchy/current/theme/hyprland.lua" ] && [ -d /usr/share/omarchy/themes/tokyo-night ]; then
    mkdir -p "$user_dir/.local/state/omarchy/current/theme" \
             "$user_dir/.config/btop/themes" \
             "$user_dir/.config/mako" \
             "$user_dir/.config/eza"
    cp -rf /usr/share/omarchy/themes/tokyo-night/. "$user_dir/.local/state/omarchy/current/theme/"
    printf 'tokyo-night\n' > "$user_dir/.local/state/omarchy/current/theme.name"
    first_bg=""
    for bg_cand in "$user_dir/.local/state/omarchy/current/theme/backgrounds/"*; do
      [ -f "$bg_cand" ] && { first_bg="$bg_cand"; break; }
    done
    if [ -n "$first_bg" ]; then
      bg_bn="${first_bg##*/}"
      ln -snf "/home/$user_name/.local/state/omarchy/current/theme/backgrounds/$bg_bn" "$user_dir/.local/state/omarchy/current/background"
    fi
    [ -f "$user_dir/.local/state/omarchy/current/theme/btop.theme" ] && cp -f "$user_dir/.local/state/omarchy/current/theme/btop.theme" "$user_dir/.config/btop/themes/current.theme"
    [ -f "$user_dir/.local/state/omarchy/current/theme/mako.ini" ] && cp -f "$user_dir/.local/state/omarchy/current/theme/mako.ini" "$user_dir/.config/mako/config"
    [ -f "$user_dir/.local/state/omarchy/current/theme/eza.yml" ] && cp -f "$user_dir/.local/state/omarchy/current/theme/eza.yml" "$user_dir/.config/eza/theme.yml"
  fi

  find "$user_dir" -xdev -user 0 -exec chown -h "$uid_gid" {} + 2>/dev/null || true

  if [ ! -f "$user_dir/.local/state/omarchy/done/finalize-user" ] && [ -x /usr/share/omarchy/bin/omarchy-provision-user ]; then
    su - "$user_name" -c "OMARCHY_PATH=/usr/share/omarchy OMARCHY_SETUP_CONTEXT=provision-owner PATH=/usr/share/omarchy/bin:/usr/local/bin:/usr/bin /usr/share/omarchy/bin/omarchy-provision-user --force --first-install" 2>/dev/null || true
  fi
done
exit 0
HEALEOF
chmod 755 /sysroot/usr/local/sbin/fedomakase-user-heal
cat > /sysroot/etc/systemd/system/fedomakase-user-heal.service << 'SVCEOF'
[Unit]
Description=Fedomakase Omarchy user provisioning
After=local-fs.target home.mount googlebook-gpu-init.service
Before=sddm.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fedomakase-user-heal
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target graphical.target
SVCEOF
mkdir -p /sysroot/etc/systemd/system/multi-user.target.wants /sysroot/etc/systemd/system/graphical.target.wants
ln -sf ../fedomakase-user-heal.service /sysroot/etc/systemd/system/multi-user.target.wants/fedomakase-user-heal.service
ln -sf ../fedomakase-user-heal.service /sysroot/etc/systemd/system/graphical.target.wants/fedomakase-user-heal.service

chroot /sysroot restorecon -F /etc/shadow /etc/passwd /etc/group 2>/dev/null || true

if [ "$HOME_MOUNTED_BY_SYNC" = 1 ]; then
  sync
  umount /sysroot/home 2>/dev/null || true
fi
exit 0
