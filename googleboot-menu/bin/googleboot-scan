#!/bin/bash
# googleboot-scan
# Petitboot-style OS discovery, LUKS2 unlock, GPT A/B slot switch, and kexec/switch-root
# execution backend for googleboot-menu.
# Uses pure built-in bash string manipulation (zero dependency on awk/cut/ls/basename in minimal initramfs).
#
# Output format for `--list`:
#   id|title|subtitle|os_type|needs_luks(0/1)|luks_dev|action_cmd

set -uo pipefail

MNT_BASE="/run/googleboot"
BOOT_MNT="$MNT_BASE/boot"
USB_MNT="$MNT_BASE/usb"
STATE_FILE="$MNT_BASE/entries.db"
KEY_FILE="$MNT_BASE/luks.key"
mkdir -p "$BOOT_MNT" "$USB_MNT" 2>/dev/null || true

modprobe nvme nvme_core ext4 btrfs vfat fat dm_crypt usb_storage uas 2>/dev/null || true

# dracut copies the host's NAME/ID into initrd-release, so the menu shows the installed distro.
OS_NAME="Fedora" OS_ID="fedora"
if [[ -r /etc/initrd-release ]]; then
  OS_NAME=$(. /etc/initrd-release; echo "${NAME:-Fedora}")
  OS_ID=$(. /etc/initrd-release; echo "${ID:-fedora}")
fi

DISK="${GOOGLEBOOK_DISK:-/dev/nvme0n1}"
BOOT_PART="${GOOGLEBOOK_BOOT_PART:-/dev/nvme0n1p11}"
ROOT_PART="${GOOGLEBOOK_ROOT_PART:-/dev/nvme0n1p32}"

is_luks_part() {
  local dev="$1"
  [[ -b "$dev" ]] || return 1
  local fstype=""
  fstype=$(blkid -s TYPE -o value "$dev" 2>/dev/null || true)
  if [[ "$fstype" == "crypto_LUKS" ]]; then
    return 0
  fi
  if command -v cryptsetup >/dev/null 2>&1 && cryptsetup isLuks "$dev" 2>/dev/null; then
    return 0
  fi
  return 1
}

get_luks_uuid() {
  local dev="$1"
  local uuid=""
  uuid=$(blkid -s UUID -o value "$dev" 2>/dev/null || true)
  if [[ -z "$uuid" ]] && command -v cryptsetup >/dev/null 2>&1; then
    uuid=$(cryptsetup luksUUID "$dev" 2>/dev/null || true)
  fi
  echo "$uuid"
}

has_boot_files() {
  [[ -d "$BOOT_MNT/loader/entries" || -d "$BOOT_MNT/EFI" || -f "$BOOT_MNT/uefi-bridge.bzImage" ]] && return 0
  local f
  for f in "$BOOT_MNT"/vmlinuz-*; do
    [[ -f "$f" ]] && return 0
  done
  return 1
}

detect_root_part() {
  if [[ -b "$ROOT_PART" ]] && is_luks_part "$ROOT_PART"; then
    return 0
  fi
  if [[ -b /dev/nvme0n1p32 ]] && is_luks_part /dev/nvme0n1p32; then
    ROOT_PART="/dev/nvme0n1p32"
    return 0
  fi
  local cand
  while IFS= read -r cand; do
    if [[ -n "$cand" && -b "$cand" ]]; then
      ROOT_PART="$cand"
      return 0
    fi
  done < <(blkid -t TYPE=crypto_LUKS -o device 2>/dev/null || true)

  if [[ ! -b "$ROOT_PART" && -b /dev/nvme0n1p2 ]]; then
    ROOT_PART="/dev/nvme0n1p2"
  fi
}

mount_boot_ro() {
  detect_root_part
  if has_boot_files; then
    return 0
  fi

  local candidates=("$BOOT_PART" "/dev/nvme0n1p11" "/dev/nvme0n1p1" "/dev/nvme0n1p31")
  local blk_dev
  while IFS= read -r blk_dev; do
    [[ -n "$blk_dev" ]] && candidates+=("$blk_dev")
  done < <(blkid -t TYPE=ext4 -o device 2>/dev/null || true; blkid -t TYPE=vfat -o device 2>/dev/null || true)

  local cand seen=""
  for cand in "${candidates[@]}"; do
    [[ -b "$cand" ]] || continue
    [[ "$cand" == "$ROOT_PART" ]] && continue
    [[ " $seen " == *" $cand "* ]] && continue
    seen="$seen $cand"

    umount "$BOOT_MNT" >/dev/null 2>&1 || true
    if mount -o ro "$cand" "$BOOT_MNT" >/dev/null 2>&1; then
      if has_boot_files; then
        BOOT_PART="$cand"
        return 0
      fi
      umount "$BOOT_MNT" >/dev/null 2>&1 || true
    fi
  done
  return 1
}

detect_os_type() {
  local text="${1,,}"
  if [[ "$text" == *omarchy* || "$text" == *fedomakase* ]]; then echo "omarchy"
  elif [[ "$text" == *fedora* ]]; then echo "fedora"
  elif [[ "$text" == *arch* || "$text" == *cachy* ]]; then echo "arch"
  elif [[ "$text" == *ubuntu* || "$text" == *debian* || "$text" == *pop* ]]; then echo "ubuntu"
  elif [[ "$text" == *nixos* ]]; then echo "arch"
  else echo "omarchy"
  fi
}

unlock_luks() {
  detect_root_part
  local dev="${GOOGLEBOOT_LUKS_DEV:-$ROOT_PART}"
  local pass="${GOOGLEBOOT_LUKS_PASS:-}"
  [[ -b "$dev" ]] || { echo "Error: LUKS device $dev not found" >&2; return 1; }

  local uuid
  uuid=$(get_luks_uuid "$dev")
  local mapper_name="luks-${uuid:-root}"

  if [[ -b "/dev/mapper/$mapper_name" ]]; then
    return 0
  fi

  [[ -n "$pass" ]] || { echo "Error: empty LUKS passphrase" >&2; return 1; }

  printf '%s' "$pass" > "$KEY_FILE"
  chmod 600 "$KEY_FILE"

  local rc=1
  if [[ -x /usr/bin/systemd-cryptsetup ]]; then
    /usr/bin/systemd-cryptsetup attach "$mapper_name" "$dev" "$KEY_FILE" discard
    rc=$?
  elif command -v cryptsetup >/dev/null 2>&1; then
    cryptsetup open "$dev" "$mapper_name" --key-file "$KEY_FILE" --allow-discards
    rc=$?
  fi
  rm -f "$KEY_FILE"

  if [[ $rc -eq 0 ]]; then
    # Alias to /etc/crypttab target name (e.g. Ubuntu dm_crypt-0 / nvme0n1p32_crypt or Arch cryptroot)
    if [[ -s /etc/crypttab ]]; then
      while read -r cname cdev _rest; do
        [[ -z "$cname" || "$cname" == \#* || "$cname" == "$mapper_name" ]] && continue
        if [[ "$cdev" == "UUID=$uuid" || "$cdev" == "$dev" ]]; then
          ln -snf "$mapper_name" "/dev/mapper/$cname" 2>/dev/null || true
        fi
      done < /etc/crypttab
    fi
    udevadm trigger --action=change 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || true
  fi
  return $rc
}

heal_slot_a_if_both_linux() {
  if [[ -b /dev/nvme0n1p20 && -b /dev/nvme0n1p21 ]] &&
     grep -a -q -E "androidboot\.(googleboot|fedomakase)=1" /dev/nvme0n1p20 2>/dev/null &&
     grep -a -q -E "androidboot\.(googleboot|fedomakase)=1" /dev/nvme0n1p21 2>/dev/null &&
     [[ -f "$BOOT_MNT/slotb-backup/android-stock/boot_a.img" &&
        -f "$BOOT_MNT/slotb-backup/android-stock/init_boot_a.img" &&
        -f "$BOOT_MNT/slotb-backup/android-stock/vendor_boot_a.img" ]]; then
    cat "$BOOT_MNT/slotb-backup/android-stock/boot_a.img" > /dev/nvme0n1p13 2>/dev/null || true
    cat "$BOOT_MNT/slotb-backup/android-stock/init_boot_a.img" > /dev/nvme0n1p18 2>/dev/null || true
    cat "$BOOT_MNT/slotb-backup/android-stock/vendor_boot_a.img" > /dev/nvme0n1p20 2>/dev/null || true
    if [[ -f "$BOOT_MNT/slotb-backup/android-stock/vbmeta_a.img" ]]; then
      cat "$BOOT_MNT/slotb-backup/android-stock/vbmeta_a.img" > /dev/nvme0n1p15 2>/dev/null || true
    fi
    sync 2>/dev/null || true
    if [[ -x /usr/local/bin/googleboot-menu ]]; then
      /usr/local/bin/googleboot-menu --switch-slot b --disk "$DISK" >/dev/null 2>&1 || true
    fi
  fi
}

scan_entries() {
  : > "$STATE_FILE" 2>/dev/null || true
  mount_boot_ro || true
  heal_slot_a_if_both_linux

  local needs_luks=0
  if is_luks_part "$ROOT_PART"; then
    local uuid
    uuid=$(get_luks_uuid "$ROOT_PART")
    if [[ ! -b "/dev/mapper/luks-${uuid:-root}" ]]; then
      needs_luks=1
    fi
  fi

  local found_linux=0

  # Slot B can only direct-boot its own kernel, so that is the main card; the rest go under Advanced options.
  # shortcut: falls back to the last glob match (lexical, 7.2.9 sorts after 7.2.11), fine while Slot B matches an entry.
  #
  # That shortcut does not survive an ostree deployment. Its entries are named
  # ostree-<n>[-<stateroot>].conf and carry no kernel version, so the uname match below never
  # fires and lexical order decides - which is right only while there are fewer than ten
  # deployments, because libostree sets n = n_deployments - index and ostree-10.conf sorts
  # before ostree-2.conf. The deployment that boots next is index 0: the highest "version",
  # with a title ending in ":0)". That is the rule googlebook-pack-slotb packs by
  # (bls_default_entry), and the main card has to agree with it, or the big card offers to
  # direct-boot a kernel whose ostree= is not the one in Slot B's vendor_cmdline.
  local primary="" ost_primary="" ost_exact="" ost_best_v=-1 running_kver
  local cand_conf cand_k cand_v c_title c_version c_options c_has_linux
  running_kver=$(uname -r 2>/dev/null || true)
  for cand_conf in "$BOOT_MNT"/loader/entries/*.conf; do
    [[ -f "$cand_conf" && "$cand_conf" != *rescue* ]] || continue
    c_title="" c_version="" c_options="" c_has_linux=0
    while IFS=' ' read -r cand_k cand_v; do
      case "$cand_k" in
        linux)   [[ -f "$BOOT_MNT/$cand_v" ]] && c_has_linux=1 ;;
        title)   c_title="$cand_v" ;;
        version) c_version="$cand_v" ;;
        options) c_options="$cand_v" ;;
      esac
    done < "$cand_conf"
    (( c_has_linux )) || continue
    primary="$cand_conf"
    case "$c_options" in
      *ostree=*)
        if [[ -z "$ost_exact" ]]; then
          case "$c_title" in
            *":0)")
              ost_primary="$cand_conf" ost_exact=1 ;;
            *)
              if [[ "$c_version" =~ ^[0-9]+$ ]] && (( c_version > ost_best_v )); then
                ost_best_v=$c_version ost_primary="$cand_conf"
              fi ;;
          esac
        fi ;;
    esac
    [[ -z "$ost_primary" && -n "$running_kver" && "$cand_conf" == *"$running_kver"* ]] && break
  done
  [[ -n "$ost_primary" ]] && primary="$ost_primary"

  # 1. Scan BootLoaderSpec (BLS) entries on /boot (/loader/entries/*.conf)
  if [[ -d "$BOOT_MNT/loader/entries" ]]; then
    for conf in "$BOOT_MNT"/loader/entries/*.conf; do
      [[ -f "$conf" ]] || continue
      [[ "$conf" == *rescue* ]] && continue
      local bn="${conf##*/}"
      local id="bls:${bn%.conf}"
      local title="" version="" linux="" initrd="" options="" k v
      while IFS=' ' read -r k v; do
        case "$k" in
          title)   title="${v^^}" ;;
          version) version="${v^^}" ;;
          linux)   linux="$v" ;;
          initrd)  initrd="$v" ;;
          options) options="$v" ;;
        esac
      done < "$conf"
      [[ -n "$linux" && -f "$BOOT_MNT/$linux" ]] || continue

      local os_type
      os_type=$(detect_os_type "$title")
      local card_title="${title:-$OS_NAME}"
      # "version" is a kernel version on a package-based install, but on an ostree
      # deployment libostree writes n_deployments - index there, so every card would read
      # "KERNEL 2". libostree always names the kernel vmlinuz-<kver>, so for those entries
      # take the label off the basename instead.
      local kver_label="$version"
      case "$options" in
        *ostree=*) [[ "${linux##*/}" == vmlinuz-* ]] && kver_label="${linux##*/vmlinuz-}" ;;
      esac
      kver_label="${kver_label^^}"
      local card_sub="KERNEL ${kver_label} - DIRECT BOOT" group=0
      if [[ "$conf" == "$primary" ]]; then
        card_title="$OS_NAME"
        os_type=$(detect_os_type "$OS_ID")
      elif command -v kexec >/dev/null 2>&1; then
        card_title="${title%% (*}" card_sub="KERNEL ${kver_label} - KEXEC" group=1
      else
        card_title="${title%% (*}" card_sub="KERNEL ${kver_label} - NEEDS KEXEC" group=2
      fi
      echo "${id}|${card_title}|${card_sub}|${os_type}|${needs_luks}|${ROOT_PART}|/usr/local/bin/googleboot-scan --boot ${id}|${group}"
      echo "${id}|${BOOT_MNT}/${linux}|${BOOT_MNT}/${initrd}|${options}" >> "$STATE_FILE"
      found_linux=1
    done
  fi

  # Fallback if no BLS entries found but vmlinuz-* exists on /boot
  if [[ $found_linux -eq 0 ]]; then
    for vmlinuz in "$BOOT_MNT"/vmlinuz-*; do
      [[ -f "$vmlinuz" ]] || continue
      [[ "$vmlinuz" == *rescue* ]] && continue
      local kver="${vmlinuz##*vmlinuz-}"
      local initrd="$BOOT_MNT/initramfs-${kver}.img"
      [[ -f "$initrd" ]] || initrd="$BOOT_MNT/initrd.img-${kver}"
      local id="kver:${kver}"
      # Slot B's cmdline was built by googlebook-pack-slotb for this root (subvol/LUKS/ext4 as detected).
      local cmdline
      cmdline=$(</proc/cmdline)
      echo "${id}|${OS_NAME}|KERNEL ${kver^^}|$(detect_os_type "$OS_ID")|${needs_luks}|${ROOT_PART}|/usr/local/bin/googleboot-scan --boot ${id}"
      echo "${id}|${vmlinuz}|${initrd}|${cmdline}" >> "$STATE_FILE"
      found_linux=1
    done
  fi

  # Guaranteed fallback: whenever /dev/nvme0n1p32 or a LUKS root partition exists on disk,
  # always emit the primary Fedora card even if /boot is unmounted or empty.
  if [[ $found_linux -eq 0 ]]; then
    if [[ -b "$ROOT_PART" ]] || [[ -b /dev/nvme0n1p32 ]] || is_luks_part "$ROOT_PART"; then
      echo "fedomakase|${OS_NAME}|${OS_NAME}|$(detect_os_type "$OS_ID")|${needs_luks}|${ROOT_PART}|/usr/local/bin/googleboot-scan --boot fedomakase"
      echo "fedomakase|SlotB-Direct|SlotB-Initrd|root=${ROOT_PART}" >> "$STATE_FILE"
      found_linux=1
    fi
  fi

  # 2. Googlebook OS (Android 17 Slot A One-Shot Boot)
  echo "android|Googlebook OS|Android 17 • Slot A (One-Shot)|android|0||/usr/local/bin/googleboot-scan --boot android"

  # 3. Windows 11 Bare-Metal (via U-Boot EFI / EDK2 UEFI Bridge payload)
  if [[ -f "$BOOT_MNT/uefi-bridge.bzImage" ]]; then
    echo "windows|WINDOWS 11|UEFI BRIDGE -> BOOTMGFW.EFI|windows|0||/usr/local/bin/googleboot-scan --boot windows"
  fi

  # 4. Scan External USB Drives for Live Linux ISOs (Fedora, Arch, Ubuntu, etc.)
  for dev in /dev/sd*[0-9] /dev/sd[a-z] /dev/vd*[0-9] /dev/vd[a-z]; do
    [[ -b "$dev" ]] || continue
    local bdev="${dev##*/}"
    local mp="$USB_MNT/$bdev"
    mkdir -p "$mp" 2>/dev/null || true
    if mount -o ro "$dev" "$mp" >/dev/null 2>&1; then
      local label
      label=$(blkid -s LABEL -o value "$dev" 2>/dev/null || echo "$bdev")
      label="${label^^}"
      local hw_args="rd.driver.pre=coreboot_table,framebuffer-coreboot clk_ignore_unused xe.enable_psr=0 modprobe.blacklist=i915"
      if [[ -f "$mp/images/pxeboot/vmlinuz" && -f "$mp/images/pxeboot/initrd.img" ]]; then
        local id="usb:$bdev"
        local cmdline="root=live:CDLABEL=${label} rd.live.image quiet rhgb ${hw_args}"
        if [[ -f "$mp/images/install.img" && ! -f "$mp/LiveOS/squashfs.img" ]]; then
          cmdline="inst.stage2=hd:LABEL=${label} ${hw_args}"
        fi
        echo "${id}|LIVE USB: ${label}|FEDORA / OMARCHY LIVE ISO|usb|0||/usr/local/bin/googleboot-scan --boot ${id}"
        echo "${id}|${mp}/images/pxeboot/vmlinuz|${mp}/images/pxeboot/initrd.img|${cmdline}" >> "$STATE_FILE"
      elif [[ -f "$mp/arch/boot/x86_64/vmlinuz-linux" && -f "$mp/arch/boot/x86_64/initramfs-linux.img" ]]; then
        local id="usb:$bdev"
        local cmdline="archisobasedir=arch archisolabel=${label} cow_spacesize=4G ${hw_args}"
        echo "${id}|LIVE USB: ${label}|ARCH LINUX LIVE ISO|arch|0||/usr/local/bin/googleboot-scan --boot ${id}"
        echo "${id}|${mp}/arch/boot/x86_64/vmlinuz-linux|${mp}/arch/boot/x86_64/initramfs-linux.img|${cmdline}" >> "$STATE_FILE"
      elif [[ -f "$mp/casper/vmlinuz" ]]; then
        local id="usb:$bdev"
        local initrd=""
        for ir in "$mp"/casper/initrd*; do [[ -f "$ir" ]] && { initrd="$ir"; break; }; done
        local cmdline="boot=casper quiet splash ${hw_args} ---"
        echo "${id}|LIVE USB: ${label}|UBUNTU / DEBIAN LIVE ISO|ubuntu|0||/usr/local/bin/googleboot-scan --boot ${id}"
        echo "${id}|${mp}/casper/vmlinuz|${initrd}|${cmdline}" >> "$STATE_FILE"
      else
        umount "$mp" 2>/dev/null || true
      fi
    fi
  done
}

run_sysroot_sync_now() {
  if [[ -x /usr/local/bin/googlebook-sysroot-sync ]]; then
    local luks_dev=""
    for d in /dev/mapper/luks-*; do
      [[ -b "$d" ]] && { luks_dev="$d"; break; }
    done
    if [[ -n "$luks_dev" ]]; then
      mkdir -p /sysroot 2>/dev/null || true
      if [[ ! -d /sysroot/etc ]]; then
        for opts in "subvol=root,rw" "subvol=@,rw" "rw"; do
          if mount -o "$opts" "$luks_dev" /sysroot 2>/dev/null; then
            [[ -d /sysroot/etc ]] && break
            umount /sysroot 2>/dev/null || true
          fi
        done
      fi
      if [[ -d /sysroot/etc ]]; then
        /usr/local/bin/googlebook-sysroot-sync || true
      fi
    fi
  fi
}

# Arguments this toolkit is responsible for on this hardware, regardless of where the rest of
# the command line comes from - the same set googlebook-pack-slotb bakes into vendor_boot_b
# (GB_ARGS), minus "bootconfig", which belongs only to a boot image that carries one.
#
# A BLS entry's own options have none of them: ostree writes root=, ostree=, rootflags= and
# "quiet rhgb" and nothing else. Handing that to kexec verbatim boots a kernel on Moonstone
# with no rd.driver.pre for the Coreboot framebuffer modules, so simpledrm never binds and
# there is no display; no console=tty0, so there is no text either; and no
# clk_ignore_unused. The machine stops with the menu's last line still on screen and the
# only way out is holding the power button. Every kexec from a BLS entry therefore gets
# these merged in - the stale-ostree fallback and the Advanced options cards alike.
GB_HW_ARGS_RD="rd.driver.pre=coreboot_table,framebuffer-coreboot"

# Pure bash: no sed/awk in the Slot B initramfs. Adds only what is missing, so an entry that
# already sets one of these keeps its own value.
merge_hw_args() {
  local cl=" $1 "
  # Drop the splash. This path is already a fallback; a silent failure here leaves no
  # display, no console and no log, which is the one failure mode nothing can diagnose.
  cl="${cl// quiet / }"
  cl="${cl// rhgb / }"
  case "$cl" in *" rw "*|*" ro "*) ;; *) cl="$cl rw " ;; esac
  case "$cl" in *" console=tty0 "*) ;; *) cl="$cl console=tty0 " ;; esac
  case "$cl" in *" rd.driver.pre="*) ;; *) cl="$cl $GB_HW_ARGS_RD " ;; esac
  case "$cl" in *" clk_ignore_unused "*) ;; *) cl="$cl clk_ignore_unused " ;; esac
  while [[ "$cl" == *"  "* ]]; do cl="${cl//  / }"; done
  cl="${cl# }"; cl="${cl% }"
  printf '%s' "$cl"
}

# Extract the ostree= argument from a command line string. Pure bash on purpose: this runs in
# the Slot B initramfs, where sed and awk are only present if some dracut module happened to
# pull them in.
ostree_arg() {
  local a
  for a in $1; do
    case "$a" in ostree=*) printf '%s' "${a#ostree=}"; return 0 ;; esac
  done
  return 1
}

boot_entry() {
  local target_id="$1"
  mount_boot_ro || true
  heal_slot_a_if_both_linux

  case "$target_id" in
    android)
      umount "$BOOT_MNT" 2>/dev/null || true
      if [[ -x /usr/local/bin/googleboot-menu ]]; then
        /usr/local/bin/googleboot-menu --switch-slot android-once --disk "$DISK" --reboot
      elif [[ -x /usr/local/bin/googlebook-switch-slot ]]; then
        /usr/local/bin/googlebook-switch-slot android-once --reboot
      fi
      sync 2>/dev/null || true
      reboot -f 2>/dev/null || echo b > /proc/sysrq-trigger
      exit 1
      ;;
    windows)
      if [[ -f "$BOOT_MNT/uefi-bridge.bzImage" ]]; then
        echo "[googleboot-scan] Chainloading UEFI Bridge (U-Boot x86_64 EFI -> bootmgfw.efi)..."
        kexec -l "$BOOT_MNT/uefi-bridge.bzImage" --command-line="console=tty0"
        kexec -e
      else
        echo "Error: $BOOT_MNT/uefi-bridge.bzImage not found. Windows boot is experimental; the bridge builder only produces an ELF research artifact." >&2
        exit 1
      fi
      ;;
    fedomakase)
      # Direct switch-root via Slot B initramfs if /boot didn't have a separate kernel entry
      if [[ -n "${GOOGLEBOOT_LUKS_PASS:-}" ]]; then
        unlock_luks || exit 1
      fi
      umount "$BOOT_MNT" 2>/dev/null || true
      udevadm settle --timeout=5 2>/dev/null || true
      exit 0
      ;;
    *)
      [[ -f "$STATE_FILE" ]] || scan_entries >/dev/null
      local fid fkernel finitrd fcmdline
      while IFS='|' read -r fid fkernel finitrd fcmdline; do
        if [[ "$fid" == "$target_id" ]]; then
          if [[ -n "${GOOGLEBOOT_LUKS_PASS:-}" ]]; then
            unlock_luks || exit 1
          fi
          local running_kver=""
          running_kver=$(uname -r 2>/dev/null || true)
          # If running inside Slot B initramfs and selected kernel matches running Slot B kernel
          # (including Arch's unversioned /boot/vmlinuz-linux), skip redundant kexec so systemd
          # mounts /sysroot via /proc/cmdline, runs googlebook-sysroot-sync.service, and switch-roots cleanly!
          # The direct path reuses the command line baked into vendor_boot_b at pack time, and
          # on an ostree deployment that line carries ostree=/ostree/boot.<n>/<stateroot>/...
          # ostree flips <n> and rewrites those paths on every deployment change, so after a
          # `bootc upgrade` that Slot B has not been repacked for, the baked path names a
          # directory that no longer exists and the boot dies in the initramfs with
          #   ostree-prepare-root: Couldn't find specified OSTree root '...': No such file or directory
          # which is unrecoverable in place, because a bootc image's root account is locked and
          # the emergency shell cannot be opened. The BLS entry's own command line is correct by
          # construction, so when the two disagree, fall through to kexec and use the entry's.
          local running_ostree="" entry_ostree="" ostree_fresh=1
          running_ostree=$(ostree_arg "$(cat /proc/cmdline 2>/dev/null)" || true)
          entry_ostree=$(ostree_arg "$fcmdline" || true)
          if [[ -n "$entry_ostree" && -n "$running_ostree" && "$running_ostree" != "$entry_ostree" ]]; then
            ostree_fresh=0
            echo "[googleboot-scan] Slot B command line is stale; re-booting via the current boot entry."
            echo "[googleboot-scan]   packed: ostree=$running_ostree"
            echo "[googleboot-scan]   entry:  ostree=$entry_ostree"
            echo "[googleboot-scan]   run googlebook-pack-slotb to make this direct again."
          fi
          if [[ -f /etc/initrd-release && ( "$fkernel" == "SlotB-Direct" || "$fkernel" == */vmlinuz-linux || ( -n "$running_kver" && "$fkernel" == *"$running_kver"* ) ) && "$target_id" != usb:* ]] \
             && (( ostree_fresh )); then
            echo "[googleboot-scan] Proceeding via direct Slot B switch-root..."
            umount "$BOOT_MNT" 2>/dev/null || true
            udevadm settle --timeout=5 2>/dev/null || true
            exit 0
          fi

          local kcmdline
          kcmdline=$(merge_hw_args "$fcmdline")
          echo "[googleboot-scan] kexec loading $fkernel (initrd=$finitrd)..."
          [[ "$kcmdline" != "$fcmdline" ]] && echo "[googleboot-scan]   cmdline: $kcmdline"
          if [[ -n "$finitrd" && -f "$finitrd" ]]; then
            kexec -l "$fkernel" --initrd="$finitrd" --command-line="$kcmdline"
          else
            kexec -l "$fkernel" --command-line="$kcmdline"
          fi
          if [[ "$target_id" != usb:* ]]; then
            umount "$BOOT_MNT" 2>/dev/null || true
            udevadm settle --timeout=5 2>/dev/null || true
            run_sysroot_sync_now
            sync 2>/dev/null || true
            umount /sysroot 2>/dev/null || true
          fi
          # Which of these two took is worth knowing from the screen: if the machine stops
          # after this line, control was handed over and the new kernel is the one that is
          # silent; if it stops before, the handoff itself is where it hung.
          echo "[googleboot-scan] handing off to the new kernel..."
          systemctl kexec 2>/dev/null || kexec -e
          echo "[googleboot-scan] kexec did not take control; still in the Slot B initramfs" >&2
          exit 0
        fi
      done < "$STATE_FILE"
      echo "Error: boot target $target_id not found" >&2
      exit 1
      ;;
  esac
}

case "${1:---list}" in
  --list)
    scan_entries
    ;;
  --unlock)
    unlock_luks
    ;;
  --boot)
    boot_entry "${2:?Missing entry ID}"
    ;;
  *)
    echo "Usage: $0 [--list | --unlock | --boot <id>]" >&2
    exit 1
    ;;
esac
