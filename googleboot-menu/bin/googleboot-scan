#!/bin/bash
# googleboot-scan
# Petitboot-style OS discovery, LUKS2 unlock, GPT A/B slot switch, and kexec/switch-root
# execution backend for googleboot-menu.
# Uses pure built-in bash string manipulation (zero dependency on awk/cut/ls/basename in minimal initramfs).
#
# Output format for `--list`:
#   id|title|subtitle|os_type|needs_luks(0/1)|luks_dev|action_cmd

set -uo pipefail

MNT_BASE="/run/googleboot"
BOOT_MNT="$MNT_BASE/boot"
USB_MNT="$MNT_BASE/usb"
STATE_FILE="$MNT_BASE/entries.db"
KEY_FILE="$MNT_BASE/luks.key"
mkdir -p "$BOOT_MNT" "$USB_MNT" 2>/dev/null || true

modprobe nvme nvme_core ext4 btrfs vfat fat dm_crypt usb_storage uas 2>/dev/null || true

DISK="${GOOGLEBOOK_DISK:-/dev/nvme0n1}"
BOOT_PART="${GOOGLEBOOK_BOOT_PART:-/dev/nvme0n1p11}"
ROOT_PART="${GOOGLEBOOK_ROOT_PART:-/dev/nvme0n1p32}"

is_luks_part() {
  local dev="$1"
  [[ -b "$dev" ]] || return 1
  local fstype=""
  fstype=$(blkid -s TYPE -o value "$dev" 2>/dev/null || true)
  if [[ "$fstype" == "crypto_LUKS" ]]; then
    return 0
  fi
  if command -v cryptsetup >/dev/null 2>&1 && cryptsetup isLuks "$dev" 2>/dev/null; then
    return 0
  fi
  return 1
}

get_luks_uuid() {
  local dev="$1"
  local uuid=""
  uuid=$(blkid -s UUID -o value "$dev" 2>/dev/null || true)
  if [[ -z "$uuid" ]] && command -v cryptsetup >/dev/null 2>&1; then
    uuid=$(cryptsetup luksUUID "$dev" 2>/dev/null || true)
  fi
  echo "$uuid"
}

has_boot_files() {
  [[ -d "$BOOT_MNT/loader/entries" || -d "$BOOT_MNT/EFI" || -f "$BOOT_MNT/uefi-bridge.bzImage" ]] && return 0
  local f
  for f in "$BOOT_MNT"/vmlinuz-*; do
    [[ -f "$f" ]] && return 0
  done
  return 1
}

detect_root_part() {
  if [[ -b "$ROOT_PART" ]] && is_luks_part "$ROOT_PART"; then
    return 0
  fi
  if [[ -b /dev/nvme0n1p32 ]] && is_luks_part /dev/nvme0n1p32; then
    ROOT_PART="/dev/nvme0n1p32"
    return 0
  fi
  local cand
  while IFS= read -r cand; do
    if [[ -n "$cand" && -b "$cand" ]]; then
      ROOT_PART="$cand"
      return 0
    fi
  done < <(blkid -t TYPE=crypto_LUKS -o device 2>/dev/null || true)

  if [[ ! -b "$ROOT_PART" && -b /dev/nvme0n1p2 ]]; then
    ROOT_PART="/dev/nvme0n1p2"
  fi
}

mount_boot_ro() {
  detect_root_part
  if has_boot_files; then
    return 0
  fi

  local candidates=("$BOOT_PART" "/dev/nvme0n1p11" "/dev/nvme0n1p1" "/dev/nvme0n1p31")
  local blk_dev
  while IFS= read -r blk_dev; do
    [[ -n "$blk_dev" ]] && candidates+=("$blk_dev")
  done < <(blkid -t TYPE=ext4 -o device 2>/dev/null || true; blkid -t TYPE=vfat -o device 2>/dev/null || true)

  local cand seen=""
  for cand in "${candidates[@]}"; do
    [[ -b "$cand" ]] || continue
    [[ "$cand" == "$ROOT_PART" ]] && continue
    [[ " $seen " == *" $cand "* ]] && continue
    seen="$seen $cand"

    umount "$BOOT_MNT" >/dev/null 2>&1 || true
    if mount -o ro "$cand" "$BOOT_MNT" >/dev/null 2>&1; then
      if has_boot_files; then
        BOOT_PART="$cand"
        return 0
      fi
      umount "$BOOT_MNT" >/dev/null 2>&1 || true
    fi
  done
  return 1
}

detect_os_type() {
  local text="${1,,}"
  if [[ "$text" == *omarchy* || "$text" == *fedomakase* ]]; then echo "omarchy"
  elif [[ "$text" == *fedora* ]]; then echo "fedora"
  elif [[ "$text" == *arch* || "$text" == *cachy* ]]; then echo "arch"
  elif [[ "$text" == *ubuntu* || "$text" == *debian* || "$text" == *pop* ]]; then echo "ubuntu"
  elif [[ "$text" == *nixos* ]]; then echo "arch"
  else echo "omarchy"
  fi
}

unlock_luks() {
  detect_root_part
  local dev="${GOOGLEBOOT_LUKS_DEV:-$ROOT_PART}"
  local pass="${GOOGLEBOOT_LUKS_PASS:-}"
  [[ -b "$dev" ]] || { echo "Error: LUKS device $dev not found" >&2; return 1; }

  local uuid
  uuid=$(get_luks_uuid "$dev")
  local mapper_name="luks-${uuid:-root}"

  if [[ -b "/dev/mapper/$mapper_name" ]]; then
    return 0
  fi

  [[ -n "$pass" ]] || { echo "Error: empty LUKS passphrase" >&2; return 1; }

  printf '%s' "$pass" > "$KEY_FILE"
  chmod 600 "$KEY_FILE"

  local rc=1
  if [[ -x /usr/bin/systemd-cryptsetup ]]; then
    /usr/bin/systemd-cryptsetup attach "$mapper_name" "$dev" "$KEY_FILE" discard
    rc=$?
  elif command -v cryptsetup >/dev/null 2>&1; then
    cryptsetup open "$dev" "$mapper_name" --key-file "$KEY_FILE" --allow-discards
    rc=$?
  fi
  rm -f "$KEY_FILE"

  if [[ $rc -eq 0 ]]; then
    printf '%s' "$pass" > "$MNT_BASE/luks.pass"
    chmod 600 "$MNT_BASE/luks.pass"
    udevadm trigger --action=change 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || true
  fi
  return $rc
}

scan_entries() {
  : > "$STATE_FILE" 2>/dev/null || true
  mount_boot_ro || true

  local needs_luks=0
  if is_luks_part "$ROOT_PART"; then
    local uuid
    uuid=$(get_luks_uuid "$ROOT_PART")
    if [[ ! -b "/dev/mapper/luks-${uuid:-root}" ]]; then
      needs_luks=1
    fi
  fi

  local found_linux=0

  # 1. Scan BootLoaderSpec (BLS) entries on /boot (/loader/entries/*.conf)
  if [[ -d "$BOOT_MNT/loader/entries" ]]; then
    for conf in "$BOOT_MNT"/loader/entries/*.conf; do
      [[ -f "$conf" ]] || continue
      [[ "$conf" == *rescue* ]] && continue
      local bn="${conf##*/}"
      local id="bls:${bn%.conf}"
      local title="" version="" linux="" initrd="" options="" k v
      while IFS=' ' read -r k v; do
        case "$k" in
          title)   title="${v^^}" ;;
          version) version="${v^^}" ;;
          linux)   linux="$v" ;;
          initrd)  initrd="$v" ;;
          options) options="$v" ;;
        esac
      done < "$conf"
      [[ -n "$linux" && -f "$BOOT_MNT/$linux" ]] || continue

      local os_type
      os_type=$(detect_os_type "$title")
      local card_title="${title:-Fedora}"
      if [[ $found_linux -eq 0 ]]; then
        card_title="Fedora"
        os_type="fedora"
      fi
      echo "${id}|${card_title}|KERNEL ${version} - DIRECT BOOT|${os_type}|${needs_luks}|${ROOT_PART}|/usr/local/bin/googleboot-scan --boot ${id}"
      echo "${id}|${BOOT_MNT}/${linux}|${BOOT_MNT}/${initrd}|${options}" >> "$STATE_FILE"
      found_linux=1
    done
  fi

  # Fallback if no BLS entries found but vmlinuz-* exists on /boot
  if [[ $found_linux -eq 0 ]]; then
    for vmlinuz in "$BOOT_MNT"/vmlinuz-*; do
      [[ -f "$vmlinuz" ]] || continue
      [[ "$vmlinuz" == *rescue* ]] && continue
      local kver="${vmlinuz##*vmlinuz-}"
      local initrd="$BOOT_MNT/initramfs-${kver}.img"
      [[ -f "$initrd" ]] || initrd="$BOOT_MNT/initrd.img-${kver}"
      local id="kver:${kver}"
      local luks_uuid="" cmdline
      luks_uuid=$(get_luks_uuid "$ROOT_PART")
      cmdline="console=tty0 rw rootflags=subvol=root rd.luks.uuid=${luks_uuid} clk_ignore_unused selinux=0"
      echo "${id}|Fedora|KERNEL ${kver^^} - OMARCHY|fedora|${needs_luks}|${ROOT_PART}|/usr/local/bin/googleboot-scan --boot ${id}"
      echo "${id}|${vmlinuz}|${initrd}|${cmdline}" >> "$STATE_FILE"
      found_linux=1
    done
  fi

  # Guaranteed fallback: whenever /dev/nvme0n1p32 or a LUKS root partition exists on disk,
  # always emit the primary Fedora card even if /boot is unmounted or empty.
  if [[ $found_linux -eq 0 ]]; then
    if [[ -b "$ROOT_PART" ]] || [[ -b /dev/nvme0n1p32 ]] || is_luks_part "$ROOT_PART"; then
      echo "fedomakase|Fedora|Fedora 44 • Omarchy Hyprland|fedora|${needs_luks}|${ROOT_PART}|/usr/local/bin/googleboot-scan --boot fedomakase"
      echo "fedomakase|SlotB-Direct|SlotB-Initrd|root=${ROOT_PART}" >> "$STATE_FILE"
      found_linux=1
    fi
  fi

  # 2. Googlebook OS (Android 17 Slot A One-Shot Boot)
  echo "android|Googlebook OS|Android 17 • Slot A (One-Shot)|android|0||/usr/local/bin/googleboot-scan --boot android"

  # 3. Windows 11 Bare-Metal (via U-Boot EFI / EDK2 UEFI Bridge payload)
  if [[ -f "$BOOT_MNT/uefi-bridge.bzImage" ]] || [[ -d "$BOOT_MNT/EFI/Microsoft/Boot" ]]; then
    echo "windows|WINDOWS 11|UEFI BRIDGE -> BOOTMGFW.EFI|windows|0||/usr/local/bin/googleboot-scan --boot windows"
  fi

  # 4. Scan External USB Drives for Live Linux ISOs (Fedora, Arch, Ubuntu, etc.)
  for dev in /dev/sd*[0-9] /dev/sd[a-z] /dev/vd*[0-9] /dev/vd[a-z]; do
    [[ -b "$dev" ]] || continue
    local bdev="${dev##*/}"
    local mp="$USB_MNT/$bdev"
    mkdir -p "$mp" 2>/dev/null || true
    if mount -o ro "$dev" "$mp" >/dev/null 2>&1; then
      local label
      label=$(blkid -s LABEL -o value "$dev" 2>/dev/null || echo "$bdev")
      label="${label^^}"
      if [[ -f "$mp/images/pxeboot/vmlinuz" && -f "$mp/images/pxeboot/initrd.img" ]]; then
        local id="usb:$bdev"
        local cmdline="root=live:CDLABEL=${label} rd.live.image quiet rhgb"
        echo "${id}|LIVE USB: ${label}|FEDORA / OMARCHY LIVE ISO|usb|0||/usr/local/bin/googleboot-scan --boot ${id}"
        echo "${id}|${mp}/images/pxeboot/vmlinuz|${mp}/images/pxeboot/initrd.img|${cmdline}" >> "$STATE_FILE"
      elif [[ -f "$mp/arch/boot/x86_64/vmlinuz-linux" && -f "$mp/arch/boot/x86_64/initramfs-linux.img" ]]; then
        local id="usb:$bdev"
        local cmdline="archisobasedir=arch archisolabel=${label} cow_spacesize=4G"
        echo "${id}|LIVE USB: ${label}|ARCH LINUX LIVE ISO|arch|0||/usr/local/bin/googleboot-scan --boot ${id}"
        echo "${id}|${mp}/arch/boot/x86_64/vmlinuz-linux|${mp}/arch/boot/x86_64/initramfs-linux.img|${cmdline}" >> "$STATE_FILE"
      elif [[ -f "$mp/casper/vmlinuz" ]]; then
        local id="usb:$bdev"
        local initrd=""
        for ir in "$mp"/casper/initrd*; do [[ -f "$ir" ]] && { initrd="$ir"; break; }; done
        local cmdline="boot=casper quiet splash ---"
        echo "${id}|LIVE USB: ${label}|UBUNTU / DEBIAN LIVE ISO|ubuntu|0||/usr/local/bin/googleboot-scan --boot ${id}"
        echo "${id}|${mp}/casper/vmlinuz|${initrd}|${cmdline}" >> "$STATE_FILE"
      else
        umount "$mp" 2>/dev/null || true
      fi
    fi
  done
}

run_sysroot_sync_now() {
  if [[ -x /usr/local/bin/googlebook-sysroot-sync ]]; then
    local luks_dev=""
    for d in /dev/mapper/luks-*; do
      [[ -b "$d" ]] && { luks_dev="$d"; break; }
    done
    if [[ -n "$luks_dev" ]]; then
      mkdir -p /sysroot 2>/dev/null || true
      if [[ ! -d /sysroot/etc ]]; then
        mount -t btrfs -o subvol=root,rw "$luks_dev" /sysroot 2>/dev/null || mount -o rw "$luks_dev" /sysroot 2>/dev/null || true
      fi
      if [[ -d /sysroot/etc ]]; then
        /usr/local/bin/googlebook-sysroot-sync || true
      fi
    fi
  fi
}

boot_entry() {
  local target_id="$1"
  mount_boot_ro || true

  case "$target_id" in
    android)
      umount "$BOOT_MNT" 2>/dev/null || true
      if [[ -x /usr/local/bin/googleboot-menu ]]; then
        /usr/local/bin/googleboot-menu --switch-slot android-once --disk "$DISK" --reboot
      elif [[ -x /usr/local/bin/googlebook-switch-slot ]]; then
        /usr/local/bin/googlebook-switch-slot android-once --reboot
      fi
      sync
      reboot -f 2>/dev/null || echo b > /proc/sysrq-trigger
      exit 1
      ;;
    windows)
      if [[ -f "$BOOT_MNT/uefi-bridge.bzImage" ]]; then
        echo "[googleboot-scan] Chainloading UEFI Bridge (U-Boot x86_64 EFI -> bootmgfw.efi)..."
        kexec -l "$BOOT_MNT/uefi-bridge.bzImage" --command-line="console=tty0"
        kexec -e
      else
        echo "Error: $BOOT_MNT/uefi-bridge.bzImage not found. Run build-uefi-bridge.sh first." >&2
        exit 1
      fi
      ;;
    fedomakase)
      # Direct switch-root via Slot B initramfs if /boot didn't have a separate kernel entry
      if [[ -n "${GOOGLEBOOT_LUKS_PASS:-}" ]]; then
        unlock_luks || exit 1
      fi
      umount "$BOOT_MNT" 2>/dev/null || true
      udevadm settle --timeout=5 2>/dev/null || true
      run_sysroot_sync_now
      exit 0
      ;;
    *)
      [[ -f "$STATE_FILE" ]] || scan_entries >/dev/null
      local fid fkernel finitrd fcmdline
      while IFS='|' read -r fid fkernel finitrd fcmdline; do
        if [[ "$fid" == "$target_id" ]]; then
          if [[ -n "${GOOGLEBOOT_LUKS_PASS:-}" ]]; then
            unlock_luks || exit 1
          fi
          local running_kver=""
          running_kver=$(uname -r 2>/dev/null || true)
          # If running inside Slot B initramfs and selected kernel matches running Slot B kernel,
          # skip redundant kexec so systemd mounts /sysroot, runs googlebook-sysroot-sync, and switch-roots cleanly!
          if [[ -f /etc/initrd-release && ( "$fkernel" == "SlotB-Direct" || ( -n "$running_kver" && "$fkernel" == *"$running_kver"* ) ) && "$target_id" != usb:* ]]; then
            echo "[googleboot-scan] Proceeding via direct Slot B switch-root..."
            umount "$BOOT_MNT" 2>/dev/null || true
            udevadm settle --timeout=5 2>/dev/null || true
            run_sysroot_sync_now
            exit 0
          fi

          echo "[googleboot-scan] kexec loading $fkernel (initrd=$finitrd)..."
          if [[ -n "$finitrd" && -f "$finitrd" ]]; then
            kexec -l "$fkernel" --initrd="$finitrd" --command-line="$fcmdline"
          else
            kexec -l "$fkernel" --command-line="$fcmdline"
          fi
          systemctl kexec 2>/dev/null || kexec -e
          exit 0
        fi
      done < "$STATE_FILE"
      echo "Error: boot target $target_id not found" >&2
      exit 1
      ;;
  esac
}

case "${1:---list}" in
  --list)
    scan_entries
    ;;
  --unlock)
    unlock_luks
    ;;
  --boot)
    boot_entry "${2:?Missing entry ID}"
    ;;
  *)
    echo "Usage: $0 [--list | --unlock | --boot <id>]" >&2
    exit 1
    ;;
esac
